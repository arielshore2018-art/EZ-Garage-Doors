---
/**
 * Fast-service landing page.
 * "Same-day" is NOT confirmed by the owner, so the copy promises fast
 * LOCAL service and "call for today's availability" — no unconditional
 * same-day claim, no after-hours promises.
 * needs-owner-confirmation: if same-day capacity is confirmed, the H1
 * may be upgraded to "Same-Day Garage Door Service in Massachusetts".
 */
import LandingLayout from "../layouts/LandingLayout.astro";
import CallButton from "../components/CallButton.astro";
import MicroTrustBar from "../components/MicroTrustBar.astro";
import Icon from "../components/Icon.astro";
import { APPROVED_CLAIMS } from "../config/business";

const fastFixes = [
  "Stuck or jammed doors",
  "Broken torsion and extension springs",
  "Snapped cables and off-track doors",
  "Opener failures, remotes, and sensors",
  "Doors that won't close or lock",
];

const service = {
  name: "Fast Local Garage Door Service",
  description: "Fast local garage door repair across Massachusetts — call for today's availability.",
  url: "/same-day-garage-door-service/",
};
---

<LandingLayout
  title="Fast Local Garage Door Service in Massachusetts | EZ Garage Doors"
  description="Stuck door, broken spring, or opener failure? Call EZ Garage Doors for fast local garage door service anywhere in Massachusetts — ask about today's availability."
  callLabel="Call for Availability"
  service={service}
>
  <section class="fast-hero">
    <div class="wrap fast-hero__inner">
      <p class="eyebrow">Fast local service · Massachusetts</p>
      <h1>Fast Local Garage Door Service in Massachusetts</h1>
      <p class="fast-hero__sub">
        For stuck doors, broken springs, opener issues, and urgent repairs, call EZ Garage Doors
        and ask about today's availability in your town.
      </p>
      <div class="fast-hero__actions">
        <CallButton label="Call for Availability" size="lg" track="fast_call_click" />
        <a href="/contact/#request" class="btn btn--outline btn--lg" data-track="estimate_click">Request Service</a>
      </div>
      <p class="fast-hero__after-hours muted">
        Calling after hours? Request service now — first callback when dispatch opens.
      </p>
      <div class="fast-hero__trust">
        <MicroTrustBar items={[APPROVED_CLAIMS.years, APPROVED_CLAIMS.local, APPROVED_CLAIMS.writtenQuote]} />
      </div>
    </div>
  </section>

  <section class="fast-list section">
    <div class="wrap">
      <h2>What we can usually fix on the first visit</h2>
      <ul class="fast-list__grid">
        {fastFixes.map((fix) => <li><Icon name="check" size={18} /><span>{fix}</span></li>)}
      </ul>
      <p class="muted fast-list__note">
        Vans are stocked for the common failures — springs, cables, rollers, and opener parts —
        so most repairs finish in one trip.
      </p>
    </div>
  </section>

  <section class="fast-quote section section--alt">
    <div class="wrap wrap--narrow">
      <h2>Fast doesn't mean loose with pricing</h2>
      <p>
        However quickly we get there, the rule holds: <strong>written quote before work
        begins</strong>. You approve the number, then we fix the door.
      </p>
    </div>
  </section>

  <section class="fast-final section--orange">
    <div class="wrap fast-final__inner">
      <h2>Need it handled today?</h2>
      <p>Call now and ask about today's availability in your town.</p>
      <CallButton label="Call for Availability" size="lg" track="fast_call_click" />
    </div>
  </section>
</LandingLayout>

<style>
  .fast-hero {
    background: linear-gradient(180deg, var(--ez-alt) 0%, var(--ez-white) 100%);
    border-bottom: 1px solid var(--ez-line);
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .fast-hero__inner {
    max-width: 46rem;
  }

  .fast-hero h1 {
    margin-top: var(--space-2);
  }

  .fast-hero__sub {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
  }

  .fast-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .fast-hero__after-hours {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .fast-hero__trust {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ez-line);
  }

  .fast-list__grid {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-3);
  }

  .fast-list__grid li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: var(--ez-alt);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-weight: 600;
    color: var(--ez-ink);
  }

  .fast-list__grid svg {
    color: var(--ez-orange);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .fast-list__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .fast-quote p {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
  }

  .fast-final {
    padding-block: var(--space-7);
    text-align: center;
  }

  .fast-final p {
    margin-block: var(--space-3) var(--space-5);
    color: var(--ez-ink);
  }
</style>
