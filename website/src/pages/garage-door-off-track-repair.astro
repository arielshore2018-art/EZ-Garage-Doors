---
/**
 * Off-track repair — urgency page with full site nav (organic intent):
 * hero with safety alert, causes, process, FAQ.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ProofColumns from "../components/home/ProofColumns.astro";
import FaqList from "../components/FaqList.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import CTASection from "../components/CTASection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";

const causes = [
  "A snapped or slipped lift cable on one side",
  "Worn rollers popping out of the track",
  "A bent track from a bump or impact",
  "Running the opener against a jammed or frozen door",
  "A broken hinge letting a panel fold",
];

const service = {
  name: "Off-Track Garage Door Repair",
  description: "Garage door off its track secured, realigned, and rolling straight across Massachusetts — with a written quote before work begins.",
  url: "/garage-door-off-track-repair/",
};

const faqs = [
  { question: "The door is hanging crooked — will it fall?", answer: "It can. An off-track door is held by whatever hardware hasn't failed yet. Keep people, pets, and cars away and don't run the opener again." },
  { question: "Can I push the rollers back into the track myself?", answer: "Please don't — the door's weight and spring tension make that dangerous, and forcing rollers back without fixing the cause puts it right back off track." },
  { question: "What does the repair involve?", answer: "We secure the door, find what pulled it off (cable, roller, or track), correct that, realign the door, and test full travel. The price is in writing before any of it starts." },
  { question: "My car is stuck behind the crooked door — what now?", answer: "Don't force the door. Call with your town — trapped-car calls are exactly what fast local dispatch is for." },
];

const crumbs = [{ label: "Garage Door Repair", href: "/garage-door-repair/" }, { label: "Off-Track Door Repair" }];
---

<SiteLayout
  title="Garage Door Off Track? Repair in Massachusetts | EZ Garage Doors"
  description="Garage door came off its track or hangs crooked? Stop the opener and call EZ Garage Doors — off-track repair across Massachusetts with a written quote first."
  service={service}
  faqs={faqs}
  breadcrumbs={crumbs}
>
  <ServiceHero
    imageId="before-old-wood"
    eyebrow="Off-track door service"
    heading="Garage Door Off Its Track?"
    sub="Stop using the opener right now — every cycle bends the tracks further and can drop the door. We secure it, realign it, and get it rolling straight."
    callLabel="Call Now"
    callTrack="offtrack_call_click"
    secondaryLabel="Send a Photo of the Door"
    alert="Keep people, pets, and cars away from an off-track door. It can shift or fall without warning."
    breadcrumbs={crumbs}
  />

  <ProofColumns />

  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="Root cause" title="Why doors come off the track" />
      <ul class="ot-causes">
        {causes.map((cause) => <li><Icon name="check" size={18} /><span>{cause}</span></li>)}
      </ul>
      <p class="ot-note callout">
        The fix is rarely just "push it back in" — whatever pulled it off has to be corrected too,
        or it happens again next week. That's what we inspect for.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap wrap--narrow">
      <SectionHeading eyebrow="The process" title="Secured, diagnosed, quoted in writing" />
      <p>
        We secure the door so it can't fall, find what pulled it off the track, and hand you the
        repair price <strong>in writing before work begins</strong>. You approve it — then we fix
        it and test the full travel.
      </p>
    </div>
  </section>

  <FaqList faqs={faqs} heading="Off-track door questions" />

  <RelatedLinks
    heading="Related repairs"
    items={[
      { label: "Track Repair", href: "/garage-door-track-repair/" },
      { label: "Roller Replacement", href: "/garage-door-roller-replacement/" },
      { label: "Cable Repair", href: "/garage-door-cable-repair/" },
      { label: "Emergency Repair", href: "/emergency-garage-door-repair/" },
    ]}
  />

  <CTASection heading="Door hanging crooked right now?" sub="Don't force it. Call EZ Garage Doors for off-track repair anywhere in Massachusetts." callLabel="Call Now" />
</SiteLayout>

<style>
  .ot-causes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-3);
  }

  .ot-causes li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: var(--ez-alt);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-weight: 600;
    color: var(--ez-ink);
  }

  .ot-causes svg {
    color: var(--ez-orange);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .ot-note {
    margin-top: var(--space-5);
    max-width: 44rem;
  }
</style>
