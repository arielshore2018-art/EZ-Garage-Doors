---
/**
 * Replacement / upgrade page — planned project, "is it time?" intent.
 * Bridges repair vs. replace, then routes to installation or cost guide.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ProofColumns from "../components/home/ProofColumns.astro";
import BeforeAfterGallery from "../components/BeforeAfterGallery.astro";
import CTASection from "../components/CTASection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TrustLogoStrip from "../components/TrustLogoStrip.astro";
import RelatedLinks from "../components/RelatedLinks.astro";

import baBefore3 from "../assets/photos/ez-before-worn-single-door.png";
import baAfter3 from "../assets/photos/ez-after-white-raised-panel.png";
import baBefore4 from "../assets/photos/ez-before-dirty-beige-door.png";
import baAfter4 from "../assets/photos/ez-after-dark-bronze-panel.png";

const replaceSigns = [
  { sign: "Repairs are stacking up", detail: "A spring this year, cables last year, panels rusting — the math starts favoring a new door." },
  { sign: "Panels are cracked, rotted, or rusted", detail: "Cosmetic damage becomes structural. Single panels can sometimes be replaced; widespread damage can't." },
  { sign: "The door pre-dates safety sensors", detail: "Very old systems lack today's safety hardware. Replacement brings the whole system current." },
  { sign: "It's loud, slow, and drafty", detail: "A modern insulated door runs quieter and keeps an attached garage noticeably warmer through a Massachusetts winter." },
  { sign: "You're selling or refreshing the house", detail: "The garage door is a huge share of street-facing facade — one of the most visible upgrades a house can get." },
];

const service = {
  name: "Garage Door Replacement",
  description: "Full garage door replacement across Massachusetts: removal of the old door and professional installation of a new one, with a written estimate first.",
  url: "/garage-door-replacement/",
};

const crumbs = [{ label: "New Garage Doors", href: "/garage-door-installation/" }, { label: "Garage Door Replacement" }];
---

<SiteLayout
  title="Garage Door Replacement in Massachusetts | EZ Garage Doors"
  description="Is it time to replace your garage door? Honest repair-vs-replace guidance, replacement signs, and a written estimate before any work. Local Massachusetts company."
  service={service}
  breadcrumbs={crumbs}
>
  <ServiceHero
    imageId="door-modern-house-two-windows"
    eyebrow="Door replacement"
    heading="Garage Door Replacement in Massachusetts"
    sub="Old door out, new door in — sizing, style, insulation, and hardware handled by one local team, with the full price in writing before anything is ordered."
    callLabel="Get My Written Estimate"
    callTrack="estimate_click"
    primaryMode="estimate"
    primaryHref="/contact/#request"
    secondaryLabel="See What Affects Cost"
    secondaryHref="/garage-door-replacement-cost/"
    micro="No pressure. One quote, in writing."
    breadcrumbs={crumbs}
  />

  <ProofColumns />

  <section class="section section--alt">
    <div class="wrap">
      <SectionHeading eyebrow="Repair or replace?" title="Signs it's time to replace the door" />
      <ul class="replace-signs">
        {replaceSigns.map((item) => <li class="replace-signs__card card"><h3>{item.sign}</h3><p>{item.detail}</p></li>)}
      </ul>
      <p class="replace-signs__honesty callout">
        <strong>And when it's not time:</strong> if one spring broke on an otherwise healthy door,
        that's a repair, not a replacement. We'll tell you which one you actually need —
        see <a href="/garage-door-repair/">garage door repair</a>.
      </p>
    </div>
  </section>

  <TrustLogoStrip variant="door-brands" />

  <BeforeAfterGallery
    heading="Recent replacements, before and after"
    pairs={[
      { before: baBefore3, after: baAfter3, caption: "Worn single door replaced with a white raised-panel door" },
      { before: baBefore4, after: baAfter4, caption: "Dirty beige door replaced with a dark bronze panel door" },
    ]}
  />

  <RelatedLinks
    heading="Two ways to move forward"
    eyebrow="Next step"
    alt={false}
    items={[
      { label: "Browse door styles", href: "/garage-door-styles/", blurb: "Insulated steel, carriage house, modern, wood-look — with photos." },
      { label: "Understand the cost", href: "/garage-door-replacement-cost/", blurb: "What drives replacement pricing — size, insulation, windows, design, hardware." },
      { label: "Panel replacement instead?", href: "/garage-door-panel-replacement/", blurb: "When one section is all you need." },
    ]}
  />

  <CTASection heading="Ready to see the number?" sub="Get a written replacement estimate — itemized, honest, and yours to keep." secondaryLabel="Get My Written Estimate" />
</SiteLayout>

<style>
  .replace-signs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  .replace-signs__card {
    padding: var(--space-5);
  }

  .replace-signs__card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .replace-signs__card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .replace-signs__honesty {
    margin-top: var(--space-5);
    max-width: 44rem;
  }
</style>
