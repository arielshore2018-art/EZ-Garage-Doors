---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ProofColumns from "../components/home/ProofColumns.astro";
import ServicePaths from "../components/home/ServicePaths.astro";
import WhyEZ from "../components/WhyEZ.astro";
import ProofBand from "../components/ProofBand.astro";
import BeforeAfterGallery from "../components/BeforeAfterGallery.astro";
import TrustLogoStrip from "../components/TrustLogoStrip.astro";
import CountyGrid from "../components/CountyGrid.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import FaqList from "../components/FaqList.astro";
import CallButton from "../components/CallButton.astro";
import LeadForm from "../components/LeadForm.astro";
import { COVERAGE, hasPhone } from "../config/business";
import baBefore1 from "../assets/photos/ez-before-dirty-beige-door.png";
import baAfter1 from "../assets/photos/ez-after-dark-bronze-panel.png";
import baBefore2 from "../assets/photos/ez-before-old-white-wood-door.png";
import baAfter2 from "../assets/photos/ez-after-white-long-panel-windows.png";

const faqs = [
  { question: "Do I need a repair or a whole new door?", answer: "A failed spring, cable, roller, or opener does not automatically mean you need a new door. We inspect the door and explain the repair options. If replacement makes more sense, you can compare the scope and written price before deciding." },
  { question: "Will I know the price before work starts?", answer: "Yes. You receive a written quote before work begins and approve the work first. The price depends on the problem, the parts needed, and the condition of your door." },
  { question: "Can you help with an urgent door problem?", answer: "Tell us if the door is stuck open, off track, or trapping your car. We’ll confirm availability and an appointment window. Keep clear of an unstable door and avoid operating it until it has been inspected." },
  { question: "Do you serve my town?", answer: `We serve all ${COVERAGE.municipalities} cities and towns in Massachusetts. Choose your county below to find local service information, and contact us to confirm scheduling for your address.` },
];
---
<SiteLayout title="Garage Door Repair & Installation in Massachusetts | EZ Garage Doors" description="Your door fixed. Your day back. Local garage door repair, openers, and new doors across Massachusetts. Written quote before work begins." faqs={faqs}>
  <HomeHero />
  <ProofColumns />
  <ServicePaths />
  <WhyEZ />
  <BeforeAfterGallery alt={false} heading="A better welcome home." pairs={[
    { before: baBefore1, after: baAfter1, caption: "Worn beige door → insulated dark bronze panel door" },
    { before: baBefore2, after: baAfter2, caption: "Aged wood door → white long-panel door with windows" },
  ]} />
  <ProcessSteps heading="From “it’s stuck” to sorted." eyebrow="Know what comes next" steps={[
    { title: "Tell us what’s happening", detail: "Share the issue and your town. You don’t need to know the name of the broken part." },
    { title: "Confirm your visit", detail: "We discuss availability and confirm the appointment window with you." },
    { title: "Approve your written quote", detail: "Understand the diagnosis, the work, and the price before the repair begins." },
  ]} />
  <ProofBand heading="Confidence starts with a track record." note="Review figures are supplied by the business and are being reverified." />
  <TrustLogoStrip variant="combined" />
  <FaqList faqs={faqs} heading="A few things you might be wondering." />
  <CountyGrid alt compact searchable />
  <section class="section home-request" aria-labelledby="home-request-heading">
    <div class="wrap home-request__grid">
      <div class="home-request__copy">
        <p class="eyebrow">One less thing to worry about</p>
        <h2 id="home-request-heading">Let’s get your door<br />back on track.</h2>
        <p>Tell us what’s going on. We’ll help you understand the next step, with a written quote before any work begins.</p>
        <ul><li>A local Massachusetts company</li><li>Repair and replacement options explained</li><li>You approve the work first</li></ul>
        {hasPhone() && <CallButton label="Prefer to talk? Call EZ" size="lg" />}
      </div>
      <LeadForm heading="How can we help?" context="home" showPhotoField={false} />
    </div>
  </section>
</SiteLayout>
<style>
  .home-request { background: var(--ez-ink); color: var(--ez-on-ink); }
  .home-request__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem, 7vw, 7rem); }
  .home-request .eyebrow { color: var(--ez-orange-on-ink); }
  .home-request h2 { color: white; font-size: clamp(3rem, 5vw, 4.5rem); margin-top: 1rem; }
  .home-request__copy > p:not(.eyebrow) { font-size: 1.2rem; margin-top: 1.5rem; max-width: 29rem; }
  .home-request ul { list-style: none; padding: 0; margin-block: 1.5rem 2rem; }
  .home-request li { margin-top: .6rem; display: flex; gap: .65rem; }
  .home-request li::before { content: "✓"; color: var(--ez-orange-on-ink); }
  @media(max-width: 56rem) { .home-request__grid { grid-template-columns: 1fr; } }
</style>
