---
/**
 * Gallery — finished doors + before/after. Captions describe door
 * styles only; no invented town/customer attributions.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FinishedDoorGallery from "../components/FinishedDoorGallery.astro";
import BeforeAfterGallery from "../components/BeforeAfterGallery.astro";
import CTASection from "../components/CTASection.astro";
import TrustLogoStrip from "../components/TrustLogoStrip.astro";
import { Image } from "astro:assets";
import { realImg } from "../config/site-images";
const featured = realImg("door-charcoal", "Gallery hero");

import doorCharcoal from "../assets/photos/ez-garage-door-charcoal-recessed-panel.png";
import doorCarriage from "../assets/photos/ez-garage-door-carriage-house-cream.png";
import doorSteel from "../assets/photos/ez-garage-door-white-flush-steel.png";
import doorBlackWin from "../assets/photos/ez-garage-door-black-flush-windows.png";
import doorWhiteCarriage from "../assets/photos/ez-garage-door-white-carriage-windows.png";
import doorWood from "../assets/photos/ez-garage-door-wood-look-walnut.png";

import baBefore1 from "../assets/photos/ez-before-old-white-wood-door.png";
import baAfter1 from "../assets/photos/ez-after-white-long-panel-windows.png";
import baBefore2 from "../assets/photos/ez-before-faded-beige-door.png";
import baAfter2 from "../assets/photos/ez-after-black-long-panel-windows.png";
import baBefore3 from "../assets/photos/ez-before-worn-single-door.png";
import baAfter3 from "../assets/photos/ez-after-white-raised-panel.png";
import baBefore4 from "../assets/photos/ez-before-dirty-beige-door.png";
import baAfter4 from "../assets/photos/ez-after-dark-bronze-panel.png";

const doors = [
  { image: doorSteel, style: "Insulated steel flush panel", detail: "Clean modern face, quiet and warm.", href: "/garage-door-styles/insulated-steel-garage-doors/" },
  { image: doorCharcoal, style: "Charcoal recessed panel", detail: "Modern color, classic panel lines.", href: "/garage-door-styles/charcoal-and-dark-finish-garage-doors/" },
  { image: doorBlackWin, style: "Black modern with windows", detail: "Vertical glass stack for daylight.", href: "/garage-door-styles/modern-garage-doors/" },
  { image: doorCarriage, style: "Carriage house", detail: "Cream finish, X-brace, black hardware.", href: "/garage-door-styles/carriage-house-garage-doors/" },
  { image: doorWhiteCarriage, style: "White carriage with windows", detail: "Grille windows, classic look.", href: "/garage-door-styles/carriage-house-garage-doors/" },
  { image: doorWood, style: "Wood-look walnut", detail: "Wood warmth, steel durability.", href: "/garage-door-styles/wood-look-garage-doors/" },
];

const crumbs = [{ label: "Finished Work" }];
---

<SiteLayout
  title="Garage Door Gallery | Finished Work by EZ Garage Doors"
  description="Finished garage door installations and before-and-after transformations across Massachusetts: insulated steel, carriage house, black modern, wood-look, and more."
  breadcrumbs={crumbs}
>
  <section class="gallery-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} class="gallery-hero__crumbs" />
      <div class="gallery-hero__intro">
        <div><p class="eyebrow">The EZ Garage Doors gallery</p><h1>Good looks.<br /><span>Great first impressions.</span></h1></div>
        <div><p class="gallery-hero__sub">A garage door is a big part of your home’s character. Explore finished doors, thoughtful details, and the difference a fresh start makes.</p><nav aria-label="Browse the gallery"><a href="#doors-heading">Explore finished doors ↓</a><a href="#before-after-heading">Before &amp; after ↓</a></nav></div>
      </div>
      <figure class="gallery-feature">
        <Image src={featured.src} alt={featured.alt} widths={[640, 960, 1440]} sizes="(max-width: 48rem) 92vw, 1140px" loading="eager" fetchpriority="high" />
        <figcaption><div><span class="eyebrow">In the details</span><h2>Classic lines. A modern finish.</h2></div><a href="/garage-door-styles/charcoal-and-dark-finish-garage-doors/">Explore dark-finish doors <span aria-hidden="true">↗</span></a></figcaption>
      </figure>
    </div>
  </section>

  <FinishedDoorGallery doors={doors} editorial heading="Find the look that feels like home." eyebrow="A closer look" />

  <TrustLogoStrip variant="door-brands" />

  <BeforeAfterGallery
    pairs={[
      { before: baBefore1, after: baAfter1, caption: "Aged wood door → white long-panel with windows" },
      { before: baBefore2, after: baAfter2, caption: "Faded panel door → black long-panel with windows" },
      { before: baBefore3, after: baAfter3, caption: "Worn single door → white raised panel" },
      { before: baBefore4, after: baAfter4, caption: "Dirty beige door → dark bronze panel" },
    ]}
  />

  <CTASection heading="Picture your garage here" sub="Request a written installation estimate with the style you have in mind." secondaryLabel="Request Installation Estimate" />
</SiteLayout>

<style>
  .gallery-hero {
    background: var(--ez-alt);
    padding-block: 2rem 3rem;
  }

  .gallery-hero__crumbs {
    margin-bottom: var(--space-4);
  }

  .gallery-hero h1 {
    margin-top: 1rem;
    font-size: clamp(3rem, 5vw, 5.25rem);
    line-height: 1;
    text-wrap: initial;
  }
  .gallery-hero h1 span { color: var(--ez-orange-text); }

  .gallery-hero__sub {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
  }
  .gallery-hero__intro { display: grid; grid-template-columns: 1.2fr 1fr; align-items: end; gap: 3rem; padding-block: 1rem 3rem; }
  .gallery-hero nav { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.2rem; }
  .gallery-hero nav a { font-size: .95rem; font-weight: 600; padding-block: .5rem; }
  .gallery-feature { margin: 0; }
  .gallery-feature > img { width: 100%; aspect-ratio: 16/8; object-fit: cover; object-position: 50% 58%; border-radius: var(--radius-lg); }
  .gallery-feature figcaption { display: flex; justify-content: space-between; gap: 1.5rem; align-items: center; padding-top: 1.5rem; }
  .gallery-feature h2 { font-size: 1.8rem; margin-top: .4rem; }
  .gallery-feature figcaption a { display: flex; align-items: center; gap: 1.2rem; min-height: 48px; font-weight: 600; }
  @media(max-width: 48rem) { .gallery-hero__intro { grid-template-columns: 1fr; gap: .75rem; padding-bottom: 2rem; } .gallery-feature > img { aspect-ratio: 4/3; } .gallery-feature figcaption { align-items: start; flex-direction: column; gap: .4rem; } }
</style>
