---
/**
 * Emergency page. Goal: a phone call in under 30 seconds.
 * Stripped layout, phone dominant, short page, no storytelling,
 * no large form above the fold. "24/7" intentionally absent (unconfirmed).
 */
import LandingLayout from "../layouts/LandingLayout.astro";
import CallButton from "../components/CallButton.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ProofColumns from "../components/home/ProofColumns.astro";
import ProofBand from "../components/ProofBand.astro";
import Icon from "../components/Icon.astro";

const commonEmergencies = [
  "Door stuck wide open and won't close",
  "Loud bang — spring snapped, door too heavy",
  "Door off its track or hanging crooked",
  "Cable snapped, door slammed down",
  "Car trapped inside before work",
  "Door won't lock or secure",
];

const service = {
  name: "Emergency Garage Door Repair",
  description: "Urgent garage door repair across Massachusetts: stuck doors, snapped springs, off-track doors, and doors that won't close.",
  url: "/emergency-garage-door-repair/",
};
---

<LandingLayout
  title="Emergency Garage Door Repair in Massachusetts | EZ Garage Doors"
  description="Door stuck open, off track, or won't close? Call EZ Garage Doors for fast local emergency garage door repair anywhere in Massachusetts with a written quote before work begins."
  callLabel="Call Now"
  service={service}
>
  <ServiceHero
    imageId="spring-safety"
    eyebrow="Urgent repair · Massachusetts"
    heading="Emergency Garage Door Repair in Massachusetts"
    sub="Door stuck open, off track, or won't close? Call EZ Garage Doors for fast local service and a written quote before work begins."
    callLabel="Call Now"
    callTrack="emergency_call_click"
    secondaryLabel="Send a Photo"
  />

  <ProofColumns />

  <section class="em-steps section--alt">
    <div class="wrap">
      <ol class="em-steps__list">
        <li><strong>Call.</strong> Tell us what the door is doing.</li>
        <li><strong>Diagnose.</strong> We confirm the problem — a photo helps.</li>
        <li><strong>Written quote.</strong> You approve the price first.</li>
        <li><strong>Repair.</strong> Door working and secured before we leave.</li>
      </ol>
    </div>
  </section>

  <section class="em-issues section">
    <div class="wrap">
      <h2>Common garage door emergencies</h2>
      <ul class="em-issues__grid">
        {commonEmergencies.map((issue) => <li><Icon name="check" size={18} /><span>{issue}</span></li>)}
      </ul>
      <p class="em-issues__safety callout">
        <strong>If the spring snapped or the door is off track:</strong> don't lift, force, or run
        the opener. The door is heavier than it looks and under tension.
      </p>
    </div>
  </section>

  <section class="em-pricing section section--alt">
    <div class="wrap wrap--narrow">
      <h2>No bait pricing — even in an emergency</h2>
      <p>
        Urgency is how bait-and-switch outfits make their money. Our rule doesn't change after
        hours: you get the price <strong>in writing before work begins</strong>, and the quote is
        the price.
      </p>
      <p class="em-pricing__brands muted">
        We work on LiftMaster, Chamberlain, Genie, and most major opener and door brands.
      </p>
    </div>
  </section>

  <ProofBand heading="Rated on the calls that couldn't wait" />

  <section class="em-final section--orange">
    <div class="wrap em-final__inner">
      <h2>Stuck right now?</h2>
      <p>Call EZ Garage Doors — fast, local help with a written quote first.</p>
      <CallButton label="Call Now" size="lg" track="emergency_call_click" />
    </div>
  </section>
</LandingLayout>

<style>
  .em-steps {
    padding-block: var(--space-5);
    border-block: 1px solid var(--ez-line);
  }

  .em-steps__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-3) var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: emstep;
    font-size: var(--text-sm);
  }

  .em-steps__list li {
    counter-increment: emstep;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .em-steps__list li::before {
    content: counter(emstep);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--ez-orange);
    color: var(--ez-white);
    font-family: var(--font-display);
    font-weight: 700;
    flex-shrink: 0;
    align-self: center;
  }

  .em-steps__list strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .em-issues__grid {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-3);
  }

  .em-issues__grid li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: var(--ez-white);
    border: 1px solid var(--ez-line);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-weight: 600;
    color: var(--ez-ink);
  }

  .em-issues__grid svg {
    color: var(--ez-orange);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .em-issues__safety {
    margin-top: var(--space-5);
    max-width: 44rem;
  }

  .em-pricing p {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
  }

  .em-pricing p.em-pricing__brands {
    font-size: var(--text-sm);
  }

  .em-final {
    padding-block: var(--space-7);
    text-align: center;
  }

  .em-final p {
    margin-block: var(--space-3) var(--space-5);
    color: var(--ez-ink);
  }
</style>
