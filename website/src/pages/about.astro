---
/**
 * About page — identity and operating principles. No invented founder
 * story, no fake team bios, no stock "our values" filler. States what
 * is verified: 15 years, local Massachusetts, how the company works.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ProofColumns from "../components/home/ProofColumns.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ReviewProof from "../components/ReviewProof.astro";
import CountyGrid from "../components/CountyGrid.astro";
import CTASection from "../components/CTASection.astro";
import { APPROVED_CLAIMS, BUSINESS, COVERAGE } from "../config/business";

const crumbs = [{ label: "About EZ Garage Doors" }];
---

<SiteLayout
  title="About EZ Garage Doors | Local Massachusetts Garage Door Company"
  description="EZ Garage Doors is a local Massachusetts garage door company with 15 years in business, serving all 351 cities and towns. Written quotes before work, no bait pricing."
  breadcrumbs={crumbs}
>
  <ServiceHero
    imageId="team-van"
    eyebrow="Fast. Reliable. Local."
    heading="About EZ Garage Doors"
    sub={`A local ${BUSINESS.state} garage door company. ${APPROVED_CLAIMS.years.toLowerCase()}, ${COVERAGE.line.toLowerCase()}, built on written quotes and straight answers.`}
    callLabel="Call EZ Garage Doors"
    callTrack="about_call_click"
    secondaryLabel="Request Service"
    secondaryHref="/contact/#request"
    micro="No pressure. One quote, in writing."
    breadcrumbs={crumbs}
  />

  <ProofColumns />

  <section class="section">
    <div class="wrap wrap--narrow">
      <SectionHeading eyebrow="How we work" title="The rules we don't bend" />
      <dl class="about-rules">
        <div>
          <dt>The quote is in writing, first.</dt>
          <dd>Every repair and every installation starts with a written quote you approve before work begins. That's the whole policy — there's no version of it with asterisks.</dd>
        </div>
        <div>
          <dt>No bait pricing.</dt>
          <dd>We don't advertise teaser prices that triple at the door. If a number sounds too good on the phone — from anyone — ask for it in writing and watch what happens.</dd>
        </div>
        <div>
          <dt>Repair when repair is right.</dt>
          <dd>A broken spring on a healthy door is a repair, not a sales opportunity. We replace doors when replacement is genuinely the better math, and we show you that math.</dd>
        </div>
        <div>
          <dt>Local, and staying that way.</dt>
          <dd>{APPROVED_CLAIMS.local} — not a national call center reselling jobs to whoever answers. The person who quotes your door is from the team that fixes it, anywhere in the state.</dd>
        </div>
        <div>
          <dt>We say what we can prove.</dt>
          <dd>You won't find claims on this site we can't back up. Review numbers come from live platforms; brands are "brands we service," not "authorized" anything; and if we don't promise an arrival time, it's because we'd rather tell you the truth on the phone.</dd>
        </div>
      </dl>
    </div>
  </section>

  <ReviewProof />

  <CountyGrid heading="Where we work" intro={`${COVERAGE.line}, in every county.`} />

  <CTASection heading="Want to see how we quote?" sub="Call about your door or request service — judge us by the paperwork." />
</SiteLayout>

<style>
  .about-rules > div {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--ez-line);
  }

  .about-rules dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--ez-ink);
    margin-bottom: var(--space-2);
  }

  .about-rules dd {
    margin: 0;
    color: var(--color-text);
  }
</style>
