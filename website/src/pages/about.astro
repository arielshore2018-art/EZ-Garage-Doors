---
/**
 * About page — identity and operating principles. No invented founder
 * story, no fake team bios, no stock "our values" filler. States what
 * is verified: 15 years, local Massachusetts, how the company works.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ProofColumns from "../components/home/ProofColumns.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ReviewProof from "../components/ReviewProof.astro";
import CountyGrid from "../components/CountyGrid.astro";
import CTASection from "../components/CTASection.astro";
import SectionImage from "../components/SectionImage.astro";
import { APPROVED_CLAIMS, BUSINESS, COVERAGE, inlineClaim } from "../config/business";

const crumbs = [{ label: "About EZ Garage Doors" }];
---

<SiteLayout
  title="About EZ Garage Doors | Local Massachusetts Garage Door Company"
  description="EZ Garage Doors is a local Massachusetts garage door company with 15 years in business, serving all 351 cities and towns. Written quotes before work, no bait pricing."
  breadcrumbs={crumbs}
>
  <ServiceHero
    imageId="door-white-carriage"
    eyebrow="Fast. Reliable. Local."
    heading="Local expertise. A simpler experience."
    sub={`We’re EZ Garage Doors, a local ${BUSINESS.state} garage door company with ${inlineClaim(APPROVED_CLAIMS.years)}. Clear advice, a written quote, and a decision that stays in your hands.`}
    callLabel="Call EZ Garage Doors"
    callTrack="about_call_click"
    secondaryLabel="Request Service"
    secondaryHref="/contact/#request"
    micro="No pressure. One quote, in writing."
    breadcrumbs={crumbs}
  />

  <ProofColumns />

  <section class="section">
    <div class="wrap about-grid">
      <div>
      <SectionHeading eyebrow="What you can expect" title="Good service starts with clarity." />
      <dl class="about-rules">
        <div>
          <dt>The quote is in writing, first.</dt>
          <dd>Understand the scope and the price before the work starts. Your written quote gives you something clear to review and approve.</dd>
        </div>
        <div>
          <dt>A price based on your door.</dt>
          <dd>Door size, condition, hardware, and the parts needed all matter. We explain what goes into your quote so you can make an informed choice.</dd>
        </div>
        <div>
          <dt>Repair when repair is right.</dt>
          <dd>A broken part doesn’t automatically call for a new door. We explain the condition of the system and help you compare repair and replacement when it makes sense.</dd>
        </div>
        <div>
          <dt>Massachusetts is our community.</dt>
          <dd>{COVERAGE.line}. From a stuck door to a planned upgrade, you’re working with a local garage door company.</dd>
        </div>
        <div>
          <dt>Room for your questions.</dt>
          <dd>Not sure what failed, which style fits, or whether you need an insulated door? You don’t need all the answers before you get in touch.</dd>
        </div>
      </dl>
      </div>
      <SectionImage imageId="new-springs" ratio="4/3" widths={[480, 720, 960]} sizes="(max-width: 62rem) 92vw, 420px" class="about-grid__image" />
    </div>
  </section>

  <ReviewProof />

  <CountyGrid heading="Where we work" intro={`${COVERAGE.line}, in every county.`} />

  <CTASection heading="Let’s make your next step an easy one." sub="Tell us about your door. Start with a clear conversation and a written quote before work begins." />
</SiteLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-7);
    align-items: start;
  }

  .about-grid :global(.about-grid__image) {
    position: sticky;
    top: 6.5rem;
  }

  @media (max-width: 62rem) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .about-grid :global(.about-grid__image) {
      position: static;
    }
  }

  .about-rules > div {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--ez-line);
  }

  .about-rules dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--ez-ink);
    margin-bottom: var(--space-2);
  }

  .about-rules dd {
    margin: 0;
    color: var(--color-text);
  }
</style>
