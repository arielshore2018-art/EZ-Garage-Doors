---
/**
 * Contact page — short form, call CTA, TCPA consent (in LeadForm).
 * Service-area business: no street address is published.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CallButton from "../components/CallButton.astro";
import LeadForm from "../components/LeadForm.astro";
import MicroTrustBar from "../components/MicroTrustBar.astro";
import CountyGrid from "../components/CountyGrid.astro";
import SectionImage from "../components/SectionImage.astro";
import { hasPhone, COVERAGE, BUSINESS } from "../config/business";

const crumbs = [{ label: "Contact" }];
---

<SiteLayout
  title="Contact EZ Garage Doors | Request Service Anywhere in Massachusetts"
  description="Contact EZ Garage Doors for garage door repair, springs, openers, or a new door anywhere in Massachusetts. Request service or a written estimate — no spam, no pressure."
  breadcrumbs={crumbs}
>
  <section class="contact-hero">
    <div class="wrap contact-hero__grid">
      <div>
        <Breadcrumbs items={crumbs} class="contact-hero__crumbs" />
        <p class="eyebrow">Contact · Massachusetts</p>
        <h1>A working door starts with a conversation.</h1>
        <p class="contact-hero__sub">
          Tell us what’s happening with your door and where you’re located.
          We’ll explain the next step and put the quote in writing before work begins.
        </p>
        <div class="contact-hero__call">
          {hasPhone() && <CallButton label="Call EZ Garage Doors" size="lg" />}
          {
            !hasPhone() && (
              <p class="cta-note">
                {/* TODO: remove once PRIMARY_PHONE is final */}
                {BUSINESS.FORM_ENDPOINT ? "Use the request form to arrange a callback." : "Online booking and our phone line are being finalized. Requests are not being accepted through this preview."}
              </p>
            )
          }
        </div>
        <ol class="contact-next"><li><strong>Tell us the issue.</strong> No technical knowledge needed.</li><li><strong>Discuss the visit.</strong> Availability is confirmed with you.</li><li><strong>Approve the quote.</strong> Before any work begins.</li></ol>
        <div class="contact-hero__trust">
          <MicroTrustBar />
        </div>
        <SectionImage imageId="contact-woman-phone" ratio="16/9" widths={[480, 720, 960]} sizes="(max-width: 62rem) 92vw, 540px" class="contact-hero__image" />
        <p class="contact-hero__note muted">
          {COVERAGE.line}. We come to you.
        </p>
      </div>
      <div>
        <LeadForm heading="Request Service or a Written Estimate" context="contact" />
      </div>
    </div>
  </section>

  <CountyGrid compact alt />
</SiteLayout>

<style>
  .contact-hero {
    background: var(--ez-alt);
    padding-block: var(--space-7);
  }

  .contact-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }

  .contact-hero__crumbs {
    margin-bottom: var(--space-4);
  }

  .contact-hero h1 {
    margin-top: var(--space-2);
  }

  .contact-hero__sub {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
    max-width: 32rem;
  }

  .contact-hero__call {
    margin-top: var(--space-5);
  }

  .contact-hero__trust {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ez-line);
  }

  .contact-hero :global(.contact-hero__image) {
    margin-top: var(--space-5);
  }

  .contact-hero__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }
  .contact-next { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: .75rem; }
  .contact-next li { padding-bottom: .75rem; border-bottom: 1px solid var(--ez-line); }

  @media (max-width: 62rem) {
    .contact-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
