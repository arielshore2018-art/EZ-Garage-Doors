---
/**
 * Cable repair — urgency page: hero with safety note, signs, quote
 * promise, real hardware gallery, FAQ.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ProofColumns from "../components/home/ProofColumns.astro";
import WorkGallery from "../components/WorkGallery.astro";
import FaqList from "../components/FaqList.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import CTASection from "../components/CTASection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";

const signs = [
  "Cable hanging loose or coiled on the floor",
  "Door lifts crooked or shudders on the way up",
  "One side higher than the other",
  "Grinding or scraping from the tracks",
  "Rollers popping or binding mid-travel",
  "Frayed cable strands near the bottom bracket",
];

const service = {
  name: "Garage Door Cable Repair & Replacement",
  description: "Snapped or slipped lift cables replaced and the door re-balanced across Massachusetts — written quote before work.",
  url: "/garage-door-cable-repair/",
};

const faqs = [
  { question: "The cable came off but the door still moves — is that OK?", answer: "No. A slipped cable puts the door's full weight on one side; every cycle bends tracks and wears the good cable. Stop running the opener and call." },
  { question: "Why did the cable snap?", answer: "Cables fray where they meet the bottom bracket — moisture, salt, age, and an out-of-balance door speed it up. We check the spring balance behind it, because a cable that 'just slipped' usually slipped for a reason." },
  { question: "Do you replace both cables?", answer: "Usually yes — both cables have the same age and wear. Replacing the pair keeps the door lifting evenly and saves a second visit." },
  { question: "Can bent track be repaired, or does it need replacing?", answer: "Minor bends can often be trued; kinked or crushed sections get replaced. You'll see which one your door needs — with the price — in the written quote before any work." },
];

const crumbs = [{ label: "Garage Door Repair", href: "/garage-door-repair/" }, { label: "Cable Repair" }];
---

<SiteLayout
  title="Garage Door Cable Repair in Massachusetts | EZ Garage Doors"
  description="Cable came off, snapped, or the door is pulling crooked? Garage door cables replaced and the door rebalanced across Massachusetts — written quote before work begins."
  service={service}
  faqs={faqs}
  breadcrumbs={crumbs}
>
  <ServiceHero
    imageId="cable-drum-closeup"
    eyebrow="Cables · Drums · Tracks"
    heading="Garage Door Cable Repair & Replacement"
    sub="Cable came off the drum, snapped, or the door is pulling crooked? Stop running the opener — a loose cable gets worse with every cycle."
    callLabel="Call for Cable Repair"
    callTrack="cable_call_click"
    secondaryLabel="Send a Photo of the Cable"
    alert="Cables are under the same tension as the springs. Don't pull, rewind, or unbolt anything — keep the door still until it's serviced."
    breadcrumbs={crumbs}
  />

  <ProofColumns />

  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="Diagnosis" title="What a failing cable looks like" />
      <ul class="cable-signs">
        {signs.map((sign) => <li><Icon name="check" size={18} /><span>{sign}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap wrap--narrow">
      <SectionHeading eyebrow="Why written matters" title="Written quote before the repair" />
      <p>
        We check the cables, drums, rollers, tracks, and the spring balance behind them. You get
        what failed, why, and the price <strong>in writing before work begins</strong>.
      </p>
    </div>
  </section>

  {/* Real hardware only — AI technician-model photos never appear in proof modules. */}
  <WorkGallery heading="Cable and hardware work" imageIds={["new-springs", "broken-spring"]} />

  <FaqList faqs={faqs} heading="Cable questions" />

  <RelatedLinks
    heading="Related repairs"
    items={[
      { label: "Cable Drum Replacement", href: "/garage-door-drum-replacement/" },
      { label: "Track Repair", href: "/garage-door-track-repair/" },
      { label: "Roller Replacement", href: "/garage-door-roller-replacement/" },
      { label: "Off-Track Door Repair", href: "/garage-door-off-track-repair/" },
    ]}
  />

  <CTASection heading="Door pulling crooked right now?" sub="Call EZ Garage Doors — fast local cable, drum, and track repair." callLabel="Call for Cable Repair" />
</SiteLayout>

<style>
  .cable-signs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-3);
  }

  .cable-signs li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: var(--ez-alt);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-weight: 600;
    color: var(--ez-ink);
  }

  .cable-signs svg {
    color: var(--ez-orange);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
</style>
