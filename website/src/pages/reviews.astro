---
/**
 * Reviews page. Uses only the approved aggregate claim. Exact
 * counts/ratings and profile links render automatically once verified
 * numbers are added to src/config/reviews.ts. No fake quotes.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProofBand from "../components/ProofBand.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CTASection from "../components/CTASection.astro";
import { APPROVED_CLAIMS } from "../config/business";

const crumbs = [{ label: "Reviews" }];
---

<SiteLayout
  title="Reviews | EZ Garage Doors — Massachusetts"
  description="EZ Garage Doors has hundreds of 5-star reviews across Google, Yelp, Angi, and other platforms. Read what Massachusetts homeowners say — on the live platforms."
  breadcrumbs={crumbs}
>
  <section class="reviews-hero">
    <div class="wrap wrap--narrow">
      <Breadcrumbs items={crumbs} class="reviews-hero__crumbs" />
      <p class="eyebrow">Reviews</p>
      <h1>Reviews</h1>
      <p class="reviews-hero__sub">{APPROVED_CLAIMS.reviews}.</p>
    </div>
  </section>

  <ProofBand heading="Rated on the platforms we can't edit" />

  <section class="section section--alt">
    <div class="wrap wrap--narrow">
      <SectionHeading eyebrow="Read them at the source" title="Why we point you to the platforms" />
      <div class="prose">
        <p>
          Anyone can paste five glowing quotes on their own website. Reviews are only proof when
          you can see them live, with dates and reviewer histories, on platforms we can't edit.
          That's where ours live — ask us for the direct links, or search "EZ Garage Doors" on
          Google, Yelp, or Angi.
        </p>
        <p class="muted">
          Had us out recently? A review on the platform of your choice genuinely helps a local
          business — and keeps us honest.
        </p>
      </div>
    </div>
  </section>

  <CTASection heading="Judge us by the next job — yours" sub="Call EZ Garage Doors or request service online." />
</SiteLayout>

<style>
  .reviews-hero {
    background: linear-gradient(180deg, var(--ez-alt) 0%, var(--ez-white) 100%);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--ez-line);
  }

  .reviews-hero__crumbs {
    margin-bottom: var(--space-4);
  }

  .reviews-hero h1 {
    margin-top: var(--space-2);
  }

  .reviews-hero__sub {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
  }
</style>
