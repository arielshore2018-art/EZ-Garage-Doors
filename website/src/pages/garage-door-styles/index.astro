---
/**
 * Door styles hub (A1's materials/styles) — only styles we install and
 * have real photos of. Estimate-first intent.
 */
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProofColumns from "../../components/home/ProofColumns.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TrustLogoStrip from "../../components/TrustLogoStrip.astro";
import LeadForm from "../../components/LeadForm.astro";
import CTASection from "../../components/CTASection.astro";
import { DOOR_STYLES } from "../../config/door-styles";
import { img } from "../../config/site-images";

const breadcrumbs = [{ label: "New Garage Doors", href: "/garage-door-installation/" }, { label: "Door Styles" }];
---

<SiteLayout
  title="Garage Door Styles & Materials in Massachusetts | EZ Garage Doors"
  description="Insulated steel, carriage house, modern, wood-look, raised-panel, and dark-finish garage doors installed across Massachusetts. Written estimate before ordering."
  breadcrumbs={breadcrumbs}
>
  <section class="styles-hero">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} class="styles-hero__crumbs" />
      <p class="eyebrow">New garage doors · Styles &amp; materials</p>
      <h1>Garage Door Styles We Install</h1>
      <p class="styles-hero__sub">
        Six directions, all available in insulated construction sized for Massachusetts winters.
        Every door is measured and priced in an itemized written estimate before it's ordered.
      </p>
      <div class="styles-hero__actions">
        <a href="#request" class="btn btn--call btn--lg" data-track="estimate_click">Get a Written Estimate</a>
        <a href="/gallery/" class="btn btn--outline btn--lg">See Finished Work</a>
      </div>
    </div>
  </section>

  <ProofColumns />

  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="Pick a direction" title="Styles and materials" />
      <ul class="style-grid">
        {
          DOOR_STYLES.map((s) => {
            const im = img(s.imageId);
            return (
              <li class="style-card">
                <a href={`/garage-door-styles/${s.slug}/`} class="style-card__media">
                  <Image src={im.src} alt={im.alt} width={720} widths={[420, 720]} sizes="(max-width: 48rem) 92vw, 360px" loading="lazy" />
                </a>
                <div class="style-card__body">
                  <h3><a href={`/garage-door-styles/${s.slug}/`}>{s.name}</a></h3>
                  <p>{s.tagline}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <TrustLogoStrip variant="door-brands" />

  <section class="section section--alt">
    <div class="wrap wrap--narrow">
      <LeadForm heading="Request Your Installation Estimate" submitLabel="Request Installation Estimate" context="door-styles" />
    </div>
  </section>

  <CTASection heading="Picture your garage with a new door" sub="Request a written installation estimate with the style you have in mind." secondaryLabel="Request Installation Estimate" secondaryHref="#request" />
</SiteLayout>

<style>
  .styles-hero {
    background: linear-gradient(180deg, var(--ez-alt) 0%, var(--ez-white) 100%);
    border-bottom: 1px solid var(--ez-line);
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .styles-hero__crumbs {
    margin-bottom: var(--space-4);
  }

  .styles-hero h1 {
    margin-top: var(--space-2);
  }

  .styles-hero__sub {
    font-size: var(--text-lg);
    max-width: 44rem;
    margin-top: var(--space-4);
  }

  .styles-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .style-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-5);
  }

  .style-card {
    background: var(--ez-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .style-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--ez-alt-deep);
  }

  .style-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .style-card__body {
    padding: var(--space-4) var(--space-5);
  }

  .style-card h3 a {
    color: var(--ez-ink);
    text-decoration: none;
  }

  .style-card h3 a:hover {
    color: var(--ez-orange-text);
  }

  .style-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }
</style>
