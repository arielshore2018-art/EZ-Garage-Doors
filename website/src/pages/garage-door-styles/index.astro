---
/**
 * Door styles hub (A1's materials/styles) — only styles we install and
 * have real photos of. Estimate-first intent.
 */
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TrustLogoStrip from "../../components/TrustLogoStrip.astro";
import LeadForm from "../../components/LeadForm.astro";
import CTASection from "../../components/CTASection.astro";
import { DOOR_STYLES } from "../../config/door-styles";
import { img } from "../../config/site-images";

const breadcrumbs = [{ label: "New Garage Doors", href: "/garage-door-installation/" }, { label: "Door Styles" }];
const feature = img("door-carriage");
---

<SiteLayout
  title="Garage Door Styles & Materials in Massachusetts | EZ Garage Doors"
  description="Insulated steel, carriage house, modern, wood-look, raised-panel, and dark-finish garage doors installed across Massachusetts. Written estimate before ordering."
  breadcrumbs={breadcrumbs}
>
  <section class="styles-hero">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} class="styles-hero__crumbs" />
      <div class="styles-hero__grid"><div>
      <p class="eyebrow">New garage doors · Styles &amp; materials</p>
      <h1>A new door.<br /><span>A whole new welcome.</span></h1>
      <p class="styles-hero__sub">
        The warmth of wood. Clean modern lines. Classic carriage-house character.
        Find your direction, then get a measured, itemized written estimate before you order.
      </p>
      <div class="styles-hero__actions">
        <a href="#request" class="btn btn--call btn--lg" data-track="estimate_click">Get a Written Estimate</a>
        <a href="/gallery/" class="btn btn--outline btn--lg">See Finished Work</a>
      </div>
      </div><figure class="styles-hero__photo"><Image src={feature.src} alt={feature.alt} widths={[480, 800, 1100]} sizes="(max-width: 56rem) 92vw, 46vw" loading="eager" fetchpriority="high" /><figcaption>Carriage-house character. Everyday convenience.</figcaption></figure></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="Pick your direction" title="Six ways to make it yours." intro="Explore the look you love. Each style guide explains materials, practical considerations, and what to discuss in your estimate." />
      <ul class="style-grid">
        {
          DOOR_STYLES.map((s, index) => {
            const im = img(s.imageId);
            return (
              <li class="style-card">
                <a href={`/garage-door-styles/${s.slug}/`} class="style-card__media">
                  <Image src={im.src} alt={im.alt} width={720} widths={[420, 720]} sizes="(max-width: 48rem) 92vw, 360px" loading="lazy" />
                </a>
                <div class="style-card__body">
                  <span class="style-card__number">0{index + 1} / THE COLLECTION</span>
                  <h3><a href={`/garage-door-styles/${s.slug}/`}>{s.name}</a></h3>
                  <p>{s.tagline}</p>
                  <a class="style-card__link" href={`/garage-door-styles/${s.slug}/`}>Explore this style <span aria-hidden="true">↗</span></a>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <TrustLogoStrip variant="door-brands" />

  <section class="section section--alt">
    <div class="wrap wrap--narrow">
      <LeadForm heading="Request Your Installation Estimate" submitLabel="Request Installation Estimate" context="door-styles" />
    </div>
  </section>

  <CTASection heading="Picture your garage with a new door" sub="Request a written installation estimate with the style you have in mind." secondaryLabel="Request Installation Estimate" secondaryHref="#request" />
</SiteLayout>

<style>
  .styles-hero {
    background: var(--ez-alt);
    border-bottom: 1px solid var(--ez-line);
    padding-block: clamp(2rem, 4vw, 4rem);
  }

  .styles-hero__crumbs {
    margin-bottom: var(--space-4);
  }

  .styles-hero h1 {
    margin-top: var(--space-2);
    font-size: clamp(3.1rem, 4.8vw, 5rem);
    line-height: 1;
  }
  .styles-hero h1 span { color: var(--ez-orange-text); }
  .styles-hero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .styles-hero__photo { margin: 0; }
  .styles-hero__photo img { width: 100%; aspect-ratio: 1.1; object-fit: cover; border-radius: var(--radius-lg); }
  .styles-hero__photo figcaption { font-size: .85rem; color: var(--ez-steel); margin-top: .75rem; }

  .styles-hero__sub {
    font-size: var(--text-lg);
    max-width: 44rem;
    margin-top: var(--space-4);
  }

  .styles-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .style-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 2rem;
  }

  .style-card {
    background: var(--ez-white);
    border-radius: 0;
    overflow: hidden;
  }

  .style-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--ez-alt-deep);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .style-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .style-card__body {
    padding: 1.4rem 0 0;
  }

  .style-card h3 a {
    color: var(--ez-ink);
    text-decoration: none;
  }

  .style-card h3 a:hover {
    color: var(--ez-orange-text);
  }

  .style-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }
  .style-card__number { display: block; color: var(--ez-orange-text); font-size: .72rem; font-weight: 650; letter-spacing: .1em; margin-bottom: .6rem; }
  .style-card h3 { font-size: 2.1rem; }
  .style-card__link { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--ez-line); min-height: 48px; margin-top: 1rem; font-weight: 650; text-decoration: none; }
  @media(max-width: 56rem) { .styles-hero__grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; } .styles-hero__photo img { aspect-ratio: 16/10; } }
  @media(max-width: 40rem) { .style-grid { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; } }
</style>
