---
/**
 * Thank-you / conversion confirmation page. Also the conversion
 * event target for form-submit tracking.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import CallButton from "../components/CallButton.astro";
import { BUSINESS } from "../config/business";
const ready = Boolean(BUSINESS.FORM_ENDPOINT);
---

<SiteLayout
  title={ready ? "Request Received | EZ Garage Doors" : "Booking Preview | EZ Garage Doors"}
  description={ready ? "A local garage door specialist from EZ Garage Doors will follow up." : "Online booking is not available yet. No request has been sent."}
  noindex
>
  <section class="thanks">
    <div class="wrap wrap--narrow thanks__inner">
      <p class="eyebrow">{ready ? "Request received" : "Booking preview"}</p>
      <h1>{ready ? "Thanks — we have your request" : "No request has been sent."}</h1>
      {!ready && <p class="thanks__sub">Online booking is not available yet. This preview does not deliver service requests.</p>}
      {ready && <>
      <p class="thanks__sub">
        A local garage door specialist will follow up. If the door situation gets worse in the
        meantime — stuck open, off track, spring snapped — call instead of waiting.
      </p>
      <ol class="thanks__next">
        <li><strong>We read your request</strong> — including any photo you attached.</li>
        <li><strong>You get a callback</strong> to confirm details and the visit window.</li>
        <li><strong>Written quote at the door</strong> — before any work begins.</li>
      </ol>
      <CallButton label="Call EZ Garage Doors" size="lg" />
      <p class="cta-note">No pressure. One quote, in writing.</p>
      </>}
      <p class="thanks__back"><a href="/">Back to the homepage</a></p>
    </div>
  </section>

  {/* A page visit is not proof of a delivered lead. Backend confirmation should own conversion tracking. */}
</SiteLayout>

<style>
  .thanks {
    padding-block: var(--space-8);
  }

  .thanks h1 {
    margin-top: var(--space-2);
  }

  .thanks__sub {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-block: var(--space-4) var(--space-5);
  }

  .thanks__next {
    list-style: none;
    padding: var(--space-4) var(--space-5);
    margin: 0 0 var(--space-5);
    display: grid;
    gap: var(--space-3);
    background: var(--ez-alt);
    border-radius: var(--radius-md);
  }

  .thanks__next strong {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .thanks__back {
    margin-top: var(--space-5);
  }
</style>
