---
/**
 * Three-column proof strip under heroes: value over label.
 * Numbers come from STATS / COVERAGE only.
 */
import { BUSINESS, STATS, COVERAGE } from "../../config/business";

const stats = [
  { value: `${BUSINESS.yearsInBusiness} Years`, label: "In Business" },
  { value: STATS.fiveStarReviews, label: "Five-Star Reviews" },
  { value: STATS.repairs, label: "Repairs Completed" },
  { value: `${COVERAGE.municipalities}`, label: "MA Cities & Towns Served" },
];
---

<section class="proof-cols">
  <ul class="wrap proof-cols__list" aria-label="EZ Garage Doors track record">
    {
      stats.map((s) => (
        <li>
          <span class="proof-cols__value">{s.value}</span>
          <span class="proof-cols__label">{s.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .proof-cols {
    background: var(--ez-white);
    border-block: 1px solid var(--ez-line);
    padding-block: var(--space-5);
  }

  .proof-cols__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    text-align: center;
  }

  .proof-cols__list li {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
  }

  .proof-cols__list li + li {
    border-left: 1px solid var(--ez-line);
  }

  .proof-cols__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.4rem);
    color: var(--ez-orange);
    line-height: 1.05;
  }

  .proof-cols__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .proof-cols__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4) var(--space-2);
    }

    .proof-cols__list li:nth-child(3) {
      border-left: 0;
    }

    .proof-cols__value {
      font-size: 1.5rem;
    }
  }
</style>
