---
/**
 * Track-record band: four verified counts on an ink field.
 * Numbers come from STATS only (owner-supplied; correction pending —
 * see STATS_STATUS in business.ts).
 */
import { STATS, APPROVED_CLAIMS } from "../../config/business";

const stats = [
  { value: STATS.repairs, label: "Doors repaired" },
  { value: STATS.springRepairs, label: "Springs replaced" },
  { value: STATS.openerServices, label: "Openers serviced" },
  { value: STATS.fiveStarReviews, label: "Five-star reviews" },
];
---

<section class="record section--dark" aria-label="Track record">
  <div class="wrap record__inner">
    <p class="record__title eyebrow">{APPROVED_CLAIMS.years} — the record so far</p>
    <dl class="record__grid">
      {
        stats.map((s) => (
          <div class="record__cell">
            <dd class="record__value display-num">{s.value}</dd>
            <dt>{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .record__inner {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .record__title {
    text-align: center;
    margin-bottom: var(--space-5);
  }

  .record__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .record__cell {
    text-align: center;
    padding: var(--space-3);
    border-left: 1px solid rgb(255 255 255 / 0.14);
  }

  .record__cell:first-child {
    border-left: 0;
  }

  .record__value {
    font-size: var(--text-mega);
    line-height: 1;
    color: var(--ez-orange-on-ink);
    margin: 0;
  }

  .record__cell dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ez-white);
    margin-top: var(--space-2);
  }

  @media (max-width: 48rem) {
    .record__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-2);
    }

    .record__cell:nth-child(3) {
      border-left: 0;
    }
  }
</style>
