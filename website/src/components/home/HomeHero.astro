---
import { Image } from "astro:assets";
import CallButton from "../CallButton.astro";
import Icon from "../Icon.astro";
import { img } from "../../config/site-images";
const van = img("van-front");
const shortcuts = [
  { label: "Door won’t open", href: "/garage-door-wont-open/" },
  { label: "Broken spring", href: "/broken-spring-repair/" },
  { label: "Opener trouble", href: "/garage-door-opener-repair/" },
  { label: "Time for a new door", href: "/garage-door-installation/" },
];
---
<section class="hero" aria-labelledby="hero-heading">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Massachusetts garage door specialists</p>
      <h1 id="hero-heading">Your door fixed.<br /><span>Your day back.</span></h1>
      <p class="hero__sub">Garage door repair, openers, and new doors. A local team, a clear explanation, and a written quote before work begins.</p>
      <div class="hero__actions">
        <CallButton label="Call for Repair" size="lg" track="home_hero_call" />
        <a href="/garage-door-styles/" class="hero__secondary" data-track="home_hero_new_door">Explore new doors <Icon name="arrow" size={19} /></a>
      </div>
      <p class="hero__reassurance"><Icon name="check" size={18} /> You approve the price. Then we get to work.</p>
    </div>
    <figure class="hero__media">
      <Image src={van.src} alt={van.alt} widths={[480, 800, 1100]} sizes="(max-width: 56rem) 92vw, 50vw" loading="eager" fetchpriority="high" />
      <figcaption><span class="hero__location"><Icon name="pin" size={20} /> Local to Massachusetts.</span><span>Fast. Reliable. Local.</span></figcaption>
    </figure>
  </div>
  <div class="hero__routes">
    <div class="wrap hero__routes-inner">
      <span class="hero__routes-label">Let’s make it EZ.</span>
      <nav aria-label="Find help for your garage door">
        {shortcuts.map((item) => <a href={item.href} data-track="home_symptom_shortcut">{item.label}<Icon name="arrow" size={16} /></a>)}
      </nav>
    </div>
  </div>
</section>
<style>
  .hero { background: var(--ez-ink); color: var(--ez-on-ink); }
  .hero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(2.5rem, 5vw, 5rem); }
  .hero .eyebrow { color: var(--ez-orange-on-ink); font-family: var(--font-body); font-size: var(--text-2xs); letter-spacing: .14em; }
  .hero h1 { color: white; font-size: clamp(3.75rem, 6.5vw, 6.25rem); line-height: .98; letter-spacing: -.025em; margin-top: 1.4rem; text-wrap: initial; }
  .hero h1 span { color: var(--ez-orange-on-ink); }
  .hero__sub { font-size: var(--text-lg); line-height: 1.65; max-width: 29rem; margin-top: 1.75rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1.25rem 1.75rem; align-items: center; margin-top: 2rem; }
  .hero__secondary { display: inline-flex; gap: .6rem; align-items: center; min-height: 48px; color: white; font-weight: 600; text-decoration: none; border-bottom: 1px solid #777777; }
  .hero__secondary:hover { color: var(--ez-orange-on-ink); border-color: currentColor; }
  .hero__reassurance { display: flex; align-items: center; gap: .5rem; font-size: var(--text-sm); margin-top: 1rem; }
  .hero__reassurance :global(svg) { color: var(--ez-orange-on-ink); flex-shrink: 0; }
  .hero__media { margin: 0; background: #303030; border-radius: var(--radius-lg); overflow: hidden; }
  .hero__media img { width: 100%; aspect-ratio: 1.13; object-fit: cover; object-position: 51% 50%; }
  .hero__media figcaption { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem 1.3rem; color: var(--ez-on-ink); font-size: var(--text-2xs); }
  .hero__location { display: flex; gap: .5rem; align-items: center; color: white; font-weight: 600; font-size: var(--text-sm); }
  .hero__location :global(svg) { color: var(--ez-orange-on-ink); }
  .hero__routes { border-top: 1px solid #414141; }
  .hero__routes-inner { display: flex; align-items: center; gap: 2rem; padding-block: 1.05rem; }
  .hero__routes-label { font-family: var(--font-display); font-size: var(--text-lg); color: var(--ez-orange-on-ink); white-space: nowrap; }
  .hero__routes nav { display: grid; grid-template-columns: repeat(4, 1fr); flex: 1; }
  .hero__routes a { color: white; text-decoration: none; display: flex; align-items: center; justify-content: space-between; gap: .7rem; padding: .5rem 1.25rem; min-height: 44px; font-size: var(--text-sm); border-left: 1px solid #414141; }
  .hero__routes a:hover { color: var(--ez-orange-on-ink); }
  @media(max-width: 56rem) {
    .hero__grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero h1 { font-size: clamp(3.6rem, 10vw, 5.5rem); }
    .hero__sub { max-width: 36rem; font-size: var(--text-base); }
    .hero__media img { aspect-ratio: 16 / 10; }
    .hero__routes-inner { display: block; }
    .hero__routes-label { display: block; margin-bottom: .6rem; }
    .hero__routes nav { grid-template-columns: 1fr 1fr; }
    .hero__routes a { padding-inline: 0 1rem; border: 0; }
  }
  @media(max-width: 36rem) {
    .hero__actions { gap: .5rem 1.4rem; }
    .hero__media figcaption > span:last-child { display: none; }
    .hero__routes a { font-size: var(--text-sm); }
  }
</style>
