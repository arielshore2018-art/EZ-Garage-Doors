---
/**
 * FAQ accordion — native <details>, no JS. Pass the same array to the
 * layout's `faqs` prop when FAQPage schema is wanted.
 */
import SectionHeading from "./SectionHeading.astro";

interface Props {
  faqs: { question: string; answer: string }[];
  heading?: string;
  eyebrow?: string;
  /** Render without the outer section padding (inside a page-grid column). */
  bare?: boolean;
}

const { faqs, heading = "Common questions", eyebrow = "Straight answers", bare = false } = Astro.props;
---

<section class:list={["faq", { section: !bare, "faq--bare": bare }]}>
  <div class:list={{ wrap: !bare, "wrap--narrow": !bare }}>
    <SectionHeading eyebrow={eyebrow} title={heading} />
    <div class="faq__list">
      {
        faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__list {
    display: grid;
    gap: var(--space-3);
  }

  .faq__item {
    background: var(--ez-white);
    border: 1px solid var(--ez-line);
    border-radius: var(--radius-md);
    padding: 0;
  }

  .faq__item[open] {
    border-color: var(--ez-orange);
  }

  .faq__item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ez-ink);
    min-height: 48px;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: "+";
    color: var(--ez-orange);
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .faq__item[open] summary::after {
    content: "–";
  }

  .faq__item p {
    padding: 0 var(--space-5) var(--space-4);
    margin: 0;
    color: var(--color-text);
  }
</style>
