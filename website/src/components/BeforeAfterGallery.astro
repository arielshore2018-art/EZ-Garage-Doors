---
/**
 * Before/after pairs. Captions describe the door style only — never
 * attributed to a named town or customer unless the owner confirms
 * a specific real job.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeading from "./SectionHeading.astro";
import { assertRealMeta } from "../config/site-images";

interface Pair {
  before: ImageMetadata;
  after: ImageMetadata;
  caption: string;
}

interface Props {
  pairs: Pair[];
  heading?: string;
  intro?: string;
  alt?: boolean;
}

const {
  pairs,
  heading = "Before and after",
  intro = "A fresh look outside. A better everyday experience. Take a closer look at our door replacements.",
  alt = true,
} = Astro.props;

/* Proof module: throws at build time for ai-model or stock imagery. */
for (const p of pairs) {
  assertRealMeta(p.before, "BeforeAfterGallery");
  assertRealMeta(p.after, "BeforeAfterGallery");
}
---

<section class:list={["section", { "section--alt": alt }]} aria-labelledby="before-after-heading">
  <div class="wrap">
    <SectionHeading id="before-after-heading" eyebrow="The difference a door makes" title={heading} intro={intro} />
    <div class="ba-grid">
      {
        pairs.map((pair) => (
          <figure class="ba-pair">
            <div class="ba-pair__images">
              <div class="ba-pair__frame">
                <span class="ba-pair__tag">Before</span>
                <Image src={pair.before} alt={`Before: ${pair.caption}`} width={640} widths={[420, 640]} sizes="(max-width: 48rem) 46vw, 320px" loading="lazy" />
              </div>
              <div class="ba-pair__frame">
                <span class="ba-pair__tag ba-pair__tag--after">After</span>
                <Image src={pair.after} alt={`After: ${pair.caption}`} width={640} widths={[420, 640]} sizes="(max-width: 48rem) 46vw, 320px" loading="lazy" />
              </div>
            </div>
            <figcaption>{pair.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    <p class="ba-more"><a href="/gallery/" class="btn btn--outline">See more finished doors →</a></p>
  </div>
</section>

<style>
  .ba-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: var(--space-5);
  }

  .ba-pair {
    margin: 0;
    background: var(--ez-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .ba-pair__images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    background: var(--ez-line);
  }

  .ba-pair__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--ez-alt-deep);
  }

  .ba-pair__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba-pair__tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--ez-ink);
    color: var(--ez-white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .ba-pair__tag--after {
    background: var(--ez-orange);
    color: var(--ez-ink);
  }

  .ba-pair figcaption {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .ba-more { margin-top: 2rem; text-align: center; }
</style>
