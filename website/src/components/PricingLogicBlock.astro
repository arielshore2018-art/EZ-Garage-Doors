---
/**
 * Pricing honesty module. Shows HOW pricing works — never fake exact
 * prices. Any real price ranges must come from the owner
 * (see /garage-door-replacement-cost).
 */
import SectionHeading from "./SectionHeading.astro";

interface Props {
  heading?: string;
  intro?: string;
  factors?: { label: string; detail: string }[];
}

const {
  heading = "How pricing works",
  intro = "No teaser prices, no surprise line items. The price depends on the actual door and parts — and you approve it in writing before work begins.",
  factors = [
    { label: "Repairs", detail: "Parts needed, door size and weight, spring system, opener condition" },
    { label: "Installations", detail: "Door size, insulation, windows, design, and hardware" },
    { label: "Every job", detail: "Written quote before work begins — you approve the price first" },
  ],
} = Astro.props;
---

<section class="section" aria-labelledby="pricing-heading">
  <div class="wrap pricing">
    <div class="pricing__copy">
      <SectionHeading eyebrow="Pricing honesty" title={heading} />
      <p>{intro}</p>
      <p class="muted">
        Wondering what a new door costs? See the
        <a href="/garage-door-replacement-cost/">garage door replacement cost guide</a>.
      </p>
    </div>
    <div class="pricing__ticket card" role="img" aria-label="What determines your quote">
      <p class="pricing__ticket-head">What sets the price</p>
      <dl>
        {
          factors.map((f) => (
            <div class="pricing__row">
              <dt>{f.label}</dt>
              <dd>{f.detail}</dd>
            </div>
          ))
        }
      </dl>
      <p class="pricing__ticket-foot">One quote. In writing. Before work begins.</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--space-7);
    align-items: center;
  }

  .pricing__copy p + p {
    margin-top: var(--space-3);
  }

  .pricing__ticket {
    padding: var(--space-5);
    border-top: 4px solid var(--ez-orange);
  }

  .pricing__ticket-head {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--ez-ink);
    margin-bottom: var(--space-3);
  }

  .pricing__ticket dl {
    margin: 0;
  }

  .pricing__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--ez-line);
  }

  .pricing__row dt {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ez-ink);
  }

  .pricing__row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pricing__ticket-foot {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 2px solid var(--ez-ink);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ez-orange-text);
  }
</style>
