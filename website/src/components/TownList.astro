---
/**
 * Alphabetical grid of town links (county hubs, the statewide index).
 * Every link resolves to a generated town page.
 */
import type { MaTown } from "../config/ma-towns";

interface Props {
  towns: MaTown[];
  heading?: string;
  id?: string;
}

const { towns, heading, id } = Astro.props;
const sorted = [...towns].sort((a, b) => a.name.localeCompare(b.name));
---

<div class="townlist" id={id}>
  {heading && <h3 class="townlist__heading">{heading}</h3>}
  <ul>
    {
      sorted.map((t) => (
        <li>
          <a href={`/service-areas/${t.slug}/`}>
            {t.name}
            {t.countySeat && <span class="townlist__seat" title="County seat">★</span>}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .townlist__heading {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .townlist ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.15rem var(--space-4);
  }

  .townlist a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0;
    min-height: 40px;
    color: var(--ez-charcoal);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    border-bottom: 1px solid var(--ez-alt-deep);
  }

  .townlist a:hover {
    color: var(--ez-orange-text);
  }

  .townlist__seat {
    color: var(--ez-orange);
    font-size: 0.7rem;
  }
</style>
