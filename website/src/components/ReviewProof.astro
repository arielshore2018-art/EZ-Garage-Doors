---
/**
 * Review proof module. Renders ONLY verified claims:
 * - The owner-approved aggregate line.
 * - Exact ratings/counts from src/config/reviews.ts (verify before launch).
 * - Real testimonials render only once verbatim reviews with live links
 *   are added — no fake quotes, ever.
 * - Proof module: takes NO image props by design. Never add stock or
 *   ai-model people here; platform logos only (ProofBand).
 */
import { APPROVED_CLAIMS } from "../config/business";
import { reviews } from "../config/reviews";
import SectionHeading from "./SectionHeading.astro";

const platforms = [
  { key: "google", label: "Google" },
  { key: "yelp", label: "Yelp" },
  { key: "angi", label: "Angi" },
] as const;
---

<section class="section section--alt" aria-labelledby="reviews-heading">
  <div class="wrap">
    <SectionHeading id="reviews-heading" eyebrow="What customers say" title={APPROVED_CLAIMS.reviewsShort} />
    <p class="review-claim">
      {APPROVED_CLAIMS.reviews}. Ask us for links to our live profiles — read the reviews
      yourself before you book.
    </p>
    <ul class="platforms" aria-label="Review platforms">
      {
        platforms.map(({ key, label }) => {
          const p = reviews[key];
          return (
            <li class="platforms__chip">
              <span class="platforms__stars" aria-hidden="true">★★★★★</span>
              {p.url ? <a href={p.url} rel="noopener">{label}</a> : <span class="platforms__name">{label}</span>}
              {p.rating && p.count ? (
                <span class="platforms__stat">{p.rating} · {p.count}+ reviews</span>
              ) : (
                <span class="platforms__stat">5-star reviews</span>
              )}
            </li>
          );
        })
      }
    </ul>
    <!--
      On-site quote cards stay OFF until verbatim reviews with live
      platform links are supplied (launch-blocker list). Until then,
      proof = live platform ratings/counts only.
    -->
  </div>
</section>

<style>
  .review-claim {
    max-width: 46rem;
    margin-bottom: var(--space-5);
  }

  .platforms {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .platforms__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--ez-white);
    border: 1px solid var(--ez-line);
    border-radius: var(--radius-md);
    padding: 0.7rem 1rem;
    box-shadow: var(--shadow-card);
  }

  .platforms__stars {
    color: var(--ez-orange);
    letter-spacing: 0.06em;
  }

  .platforms__name,
  .platforms__chip a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ez-ink);
  }

  .platforms__stat {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
