---
/**
 * Inner-page hero (A1 register): breadcrumbs, ink H1, one paragraph,
 * optional safety callout, orange call button + outline secondary,
 * policy line, rating line. Photo on the right in a rounded card.
 * Same props API as previous versions.
 */
import { Image } from "astro:assets";
import CallButton from "./CallButton.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import type { Crumb } from "./Breadcrumbs.astro";
import { img } from "../config/site-images";
import { reviews } from "../config/reviews";
import { STATS } from "../config/business";

interface Props {
  imageId: string;
  eyebrow: string;
  heading: string;
  sub: string;
  callLabel?: string;
  callTrack?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  alert?: string;
  micro?: string;
  showRating?: boolean;
  primaryMode?: "call" | "estimate";
  primaryHref?: string;
  breadcrumbs?: Crumb[];
}

const {
  imageId,
  eyebrow,
  heading,
  sub,
  callLabel = "Call for Repair",
  callTrack = "hero_call_click",
  secondaryLabel = "Request Service",
  secondaryHref = "/contact/#request",
  alert,
  micro = "Written quote before work begins.",
  showRating = true,
  primaryMode = "call",
  primaryHref = "#request",
  breadcrumbs,
} = Astro.props;

const image = img(imageId);
---

<section class="shero">
  <div class="wrap shero__grid">
    <div class="shero__copy">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} class="shero__crumbs" />}
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="shero__sub">{sub}</p>
      {alert && <p class="callout shero__alert" role="alert"><strong>Safety first:</strong> {alert}</p>}
      <div class="shero__actions">
        {
          primaryMode === "call" ? (
            <CallButton label={callLabel} size="lg" track={callTrack} />
          ) : (
            <a href={primaryHref} class="btn btn--call btn--lg" data-track={callTrack}>
              {callLabel}
            </a>
          )
        }
        <a href={secondaryHref} class="btn btn--outline btn--lg" data-track="photo_cta_click">
          {secondaryLabel}
        </a>
      </div>
      <p class="shero__micro">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
        {micro}
      </p>
      {
        showRating && (
          <p class="shero__rating">
            <span class="shero__stars" aria-hidden="true">★★★★★</span>
            <span><strong>{reviews.google.rating}</strong> on Google · {STATS.fiveStarReviews} five-star reviews across platforms</span>
          </p>
        )
      }
    </div>

    <figure class="shero__media">
      <Image
        src={image.src}
        alt={image.alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 56rem) 100vw, 44vw"
        loading="eager"
        fetchpriority="high"
        class="shero__img"
        style={`object-position: ${image.focalPointDesktop ?? "center"};`}
      />
    </figure>
  </div>
</section>

<style>
  .shero {
    background: linear-gradient(180deg, var(--ez-alt) 0%, var(--ez-white) 100%);
    border-bottom: 1px solid var(--ez-line);
  }

  .shero__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .shero__crumbs {
    margin-bottom: var(--space-4);
  }

  .shero__copy h1 {
    font-size: clamp(2.1rem, 1.5rem + 2.8vw, 3.6rem);
    margin-top: var(--space-2);
  }

  .shero__sub {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    max-width: 34rem;
    color: var(--color-text);
  }

  .shero__alert {
    margin-top: var(--space-4);
    max-width: 34rem;
    font-size: var(--text-sm);
  }

  .shero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .shero__actions :global(.btn) {
    white-space: nowrap;
  }

  .shero__micro {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ez-ink);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .shero__micro svg {
    color: var(--ez-orange);
    flex-shrink: 0;
  }

  .shero__rating {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .shero__stars {
    color: var(--ez-orange);
    letter-spacing: 0.08em;
  }

  .shero__media {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card-hover);
    aspect-ratio: 5 / 4;
    background: var(--ez-alt-deep);
  }

  .shero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 56rem) {
    .shero__grid {
      grid-template-columns: 1fr;
      padding-block: var(--space-5);
    }

    .shero__copy h1 {
      font-size: clamp(1.9rem, 1.4rem + 3.6vw, 2.7rem);
    }

    .shero__sub {
      font-size: var(--text-base);
    }

    .shero__actions :global(.btn) {
      flex: 1 1 100%;
      justify-content: center;
    }

    .shero__media {
      aspect-ratio: 16 / 10;
      order: 2;
    }
  }
</style>
