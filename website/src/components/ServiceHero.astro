---
/**
 * Service-page hero — "PROJECTED LIGHT" film split.
 * Left: mono eyebrow, stamped caps H1, splice mark, sub, sprocket-
 * margined safety note, flare-plate CTA, mono rating line.
 * Right: ONE frame on the strip with sprocket edge, frame numeral,
 * and the light leak. Same props API as previous versions.
 */
import { Image } from "astro:assets";
import CallButton from "./CallButton.astro";
import { img } from "../config/site-images";
import { reviews } from "../config/reviews";

interface Props {
  imageId: string;
  eyebrow: string;
  heading: string;
  sub: string;
  callLabel?: string;
  callTrack?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  alert?: string;
  micro?: string;
  showRating?: boolean;
  primaryMode?: "call" | "estimate";
  primaryHref?: string;
}

const {
  imageId,
  eyebrow,
  heading,
  sub,
  callLabel = "Call for Repair",
  callTrack = "hero_call_click",
  secondaryLabel = "Send a Photo",
  secondaryHref = "/contact/#request",
  alert,
  micro = "Written quote before work begins.",
  showRating = true,
  primaryMode = "call",
  primaryHref = "#request",
} = Astro.props;

const image = img(imageId);
---

<section class="shero">
  <div class="shero__grid">
    <div class="shero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <span class="splice" aria-hidden="true"></span>
      <p class="shero__sub">{sub}</p>
      {alert && <p class="shero__alert side-rail" role="alert"><strong>Safety first:</strong> {alert}</p>}
      <div class="shero__actions">
        {
          primaryMode === "call" ? (
            <CallButton label={callLabel} size="lg" track={callTrack} />
          ) : (
            <a href={primaryHref} class="btn btn--call btn--lg" data-track={callTrack}>
              {callLabel}
            </a>
          )
        }
        <a href={secondaryHref} class="shero__secondary" data-track="photo_cta_click">
          {secondaryLabel}
        </a>
      </div>
      <p class="shero__micro muted">{micro}</p>
      {
        showRating && (
          <p class="shero__rating mono">
            <span class="shero__stars" aria-hidden="true">★★★★★</span>
            <span>{reviews.google.rating} ON GOOGLE · 850+ FIVE-STAR REVIEWS ACROSS PLATFORMS</span>
          </p>
        )
      }
    </div>

    <div class="shero__strip sprockets">
      <figure class="frame shero__frame">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 56rem) 100vw, 42vw"
          loading="eager"
          fetchpriority="high"
          class="shero__img"
          style={`object-position: ${image.focalPointDesktop ?? "center"};`}
        />
      </figure>
      <span class="shero__leak" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .shero {
    background: var(--film-leader);
    border-bottom: 1px solid var(--film-rule);
    overflow: hidden;
  }

  .shero__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 0 0 0 clamp(1rem, 4vw, 2rem);
    align-items: stretch;
  }

  .shero__copy {
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .shero__copy h1 {
    font-size: clamp(2.3rem, 1.6rem + 3.2vw, 4.2rem);
    margin-top: var(--space-3);
  }

  .shero__sub {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    max-width: 32rem;
  }

  .shero__alert {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4) var(--space-3)
      calc(var(--track-stroke) + var(--track-gap) + var(--track-ghost) + var(--space-4));
    background: var(--film-panel);
    max-width: 32rem;
    color: var(--film-emulsion-bright);
    font-size: var(--text-sm);
  }

  .shero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .shero__actions :global(.btn) {
    white-space: nowrap;
  }

  .shero__secondary {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--film-emulsion);
    text-decoration-color: var(--flare);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .shero__secondary:hover {
    color: var(--flare-hot);
  }

  .shero__micro {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .shero__rating {
    margin-top: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--film-emulsion-dim);
    border-top: 1px solid var(--film-rule);
    padding-top: var(--space-3);
    max-width: 32rem;
  }

  .shero__stars {
    color: var(--flare);
    letter-spacing: 0.1em;
    font-size: var(--text-sm);
  }

  .shero__strip {
    position: relative;
    background: var(--film-panel);
    padding-inline: var(--sprocket-w);
    display: flex;
    align-items: center;
    min-height: clamp(16rem, 36vw, 30rem);
  }

  .shero__strip::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: calc(var(--sprocket-w) / 2 - var(--sprocket-hole) / 2);
    width: var(--sprocket-hole);
    background: repeating-linear-gradient(
      to bottom,
      var(--film-gap) 0,
      var(--film-gap) var(--sprocket-hole),
      transparent var(--sprocket-hole),
      transparent calc(var(--sprocket-hole) * 2.4)
    );
  }

  .shero__frame {
    margin: 0;
    width: 100%;
    align-self: stretch;
    display: flex;
  }

  .shero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shero__leak {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: clamp(3rem, 7vw, 6rem);
    background: var(--leak-gradient);
    mix-blend-mode: screen;
    opacity: 0.85;
    pointer-events: none;
  }

  @media (max-width: 56rem) {
    .shero__grid {
      grid-template-columns: 1fr;
      padding-right: clamp(1rem, 4vw, 2rem);
    }

    .shero__copy {
      padding-top: var(--space-5);
    }

    .shero__copy h1 {
      font-size: clamp(2.1rem, 1.5rem + 4vw, 2.9rem);
    }

    .shero__sub {
      font-size: var(--text-base);
    }

    .shero__actions :global(.btn) {
      flex: 1 1 100%;
      justify-content: center;
    }

    .shero__strip {
      margin-inline: calc(-1 * clamp(1rem, 4vw, 2rem)) 0;
      min-height: 15rem;
      order: 2;
    }
  }
</style>
