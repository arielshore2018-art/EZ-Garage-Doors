---
/**
 * Symptom/issue grid — meets urgent visitors at their actual problem.
 * Cards become links when an href is provided (routing to the
 * specialty page that solves that symptom).
 */
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

interface Issue {
  symptom: string;
  meaning: string;
  href?: string;
}

interface Props {
  heading?: string;
  eyebrow?: string;
  issues: Issue[];
  alt?: boolean;
  bare?: boolean;
}

const { heading = "What is your door doing?", eyebrow = "Common problems", issues, alt = false, bare = false } = Astro.props;
---

<section class:list={[{ section: !bare, "section--alt": alt && !bare }]} aria-labelledby="issues-heading">
  <div class:list={{ wrap: !bare }}>
    <SectionHeading eyebrow={eyebrow} title={heading} />
    <ul class="issues">
      {
        issues.map((issue) => (
          <li class:list={["issues__card", { "issues__card--link": !!issue.href }]}>
            {issue.href ? (
              <a href={issue.href}>
                <h3>{issue.symptom}</h3>
                <p>{issue.meaning}</p>
                <span class="issues__go">See the fix <Icon name="arrow" size={16} /></span>
              </a>
            ) : (
              <>
                <h3>{issue.symptom}</h3>
                <p>{issue.meaning}</p>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .issues {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-4);
  }

  .issues__card {
    background: var(--ez-white);
    border: 1px solid var(--ez-line);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }

  .issues__card--link {
    padding: 0;
  }

  .issues__card a {
    display: block;
    height: 100%;
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    color: inherit;
  }

  .issues__card--link:hover {
    box-shadow: var(--shadow-card);
    border-color: var(--ez-orange);
  }

  .issues__card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .issues__card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .issues__go {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ez-orange-text);
  }
</style>
