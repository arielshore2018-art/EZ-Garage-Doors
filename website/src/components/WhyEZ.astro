---
/**
 * "Why EZ Garage Doors" — four columns of verified reasons only.
 * Every line traces to APPROVED_CLAIMS / STATS / COVERAGE; nothing
 * banned (licensed, 24/7, same-day guarantee) appears here.
 */
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { APPROVED_CLAIMS, STATS, COVERAGE, BUSINESS } from "../config/business";

interface Props {
  alt?: boolean;
}

const { alt = true } = Astro.props;

const reasons: { icon: "clipboard" | "pin" | "clock" | "star"; title: string; text: string }[] = [
  {
    icon: "clipboard",
    title: APPROVED_CLAIMS.writtenQuote,
    text: "You see the full price on paper and approve it before any work starts. The quote you approve is the price you pay — no teaser numbers, no surprise line items at the door.",
  },
  {
    icon: "pin",
    title: "One local Massachusetts team",
    text: `${COVERAGE.line}. Not a national call center reselling your job — the people who quote your door are the people who fix it.`,
  },
  {
    icon: "clock",
    title: `${BUSINESS.yearsInBusiness} years of garage doors`,
    text: `${STATS.repairs} repairs, ${STATS.springRepairs} spring replacements, and ${STATS.openerServices} opener services. Vans are stocked for the common failures so most repairs finish in one trip.`,
  },
  {
    icon: "star",
    title: APPROVED_CLAIMS.reviewsShort,
    text: "Across Google, Yelp, Angi, and other platforms we can't edit. Read them at the source before you book.",
  },
];
---

<section class:list={["section", { "section--alt": alt }]} aria-labelledby="why-heading">
  <div class="wrap">
    <SectionHeading eyebrow="Why homeowners call EZ" title="A garage door company that puts the price in writing first" center />
    <ul class="why">
      {
        reasons.map((r) => (
          <li class="why__item">
            <span class="why__icon"><Icon name={r.icon} size={28} /></span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-5);
  }

  .why__item {
    background: var(--ez-white);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
  }

  .why__icon {
    display: inline-flex;
    width: 3.25rem;
    height: 3.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--ez-orange);
    color: var(--ez-white);
    margin-bottom: var(--space-3);
  }

  .why__item h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .why__item p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
