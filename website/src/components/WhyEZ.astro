---
import Icon from "./Icon.astro";
import { BUSINESS, COVERAGE } from "../config/business";
interface Props { alt?: boolean; }
const { alt = true } = Astro.props;
const reasons = [
  { title: "Understand what’s wrong.", text: "Start with a diagnosis and an explanation of the work your door needs." },
  { title: "Know the price before you decide.", text: "Get a written quote before work begins. You stay in control of the decision." },
  { title: "Work with a local company.", text: `A Massachusetts garage door company with ${BUSINESS.yearsInBusiness} years in business, serving all ${COVERAGE.counties} counties.` },
];
---
<section class:list={["section", "why-ez", { "section--alt": alt }]} aria-labelledby="why-heading">
  <div class="wrap why-ez__grid">
    <div class="why-ez__intro"><p class="eyebrow">The EZ way</p><h2 id="why-heading">A broken door is stressful.<br /><span>Getting it fixed shouldn’t be.</span></h2><p>You shouldn’t have to become a garage door expert to make a confident decision.</p><a href="/about/">Get to know EZ Garage Doors <Icon name="arrow" size={18} /></a></div>
    <ol class="why-ez__list">{reasons.map((r, i) => <li><span class="why-ez__number">0{i + 1}</span><div><h3>{r.title}</h3><p>{r.text}</p></div></li>)}</ol>
  </div>
</section>
<style>
  .why-ez__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .why-ez h2 { margin-top: 1rem; font-size: clamp(2.5rem, 4vw, 3.75rem); }
  .why-ez h2 span { color: var(--ez-orange-text); }
  .why-ez__intro > p:not(.eyebrow) { margin-top: 1.5rem; max-width: 27rem; color: var(--ez-steel); font-size: 1.15rem; }
  .why-ez__intro > a { display: inline-flex; align-items: center; gap: .7rem; margin-top: 1.5rem; font-weight: 650; min-height: 44px; }
  .why-ez__list { list-style: none; padding: 0; }
  .why-ez__list li { display: flex; gap: 1.25rem; padding-block: 1.7rem; border-bottom: 1px solid var(--ez-line); }
  .why-ez__list li:first-child { border-top: 1px solid var(--ez-line); }
  .why-ez__number { font-family: var(--font-display); font-size: 1.7rem; color: var(--ez-orange-text); }
  .why-ez__list h3 { font-size: 1.7rem; }
  .why-ez__list p { margin-top: .65rem; color: var(--ez-steel); }
  @media(max-width: 48rem) { .why-ez__grid { grid-template-columns: 1fr; } }
</style>
