---
/**
 * Section heading, film grammar: the heading speaks first; the label
 * is a strip-margin edge-code annotation sitting ON the splice rule
 * AFTER the heading — never a kicker above it (finish-review fix #4).
 */
interface Props {
  eyebrow?: string;
  title: string;
  center?: boolean;
  level?: "h2" | "h3";
}

const { eyebrow, title, center = false, level = "h2" } = Astro.props;
const Tag = level;
---

<div class:list={["section-heading", { "section-heading--center": center }]}>
  <Tag>{title}</Tag>
  <div class="section-heading__margin" aria-hidden={eyebrow ? undefined : "true"}>
    <span class="section-heading__splice"></span>
    {eyebrow && <span class="section-heading__code mono">{eyebrow}</span>}
    <span class="section-heading__rule"></span>
  </div>
</div>

<style>
  .section-heading {
    margin-bottom: var(--space-6);
    max-width: 44rem;
  }

  .section-heading--center {
    text-align: center;
    margin-inline: auto;
  }

  /* the margin line: splice mark, then the edge-code annotation
     breaking a hairline that runs off the measure */
  .section-heading__margin {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .section-heading--center .section-heading__margin {
    justify-content: center;
  }

  .section-heading__splice {
    width: 2.6rem;
    height: 3px;
    background: var(--flare);
    flex-shrink: 0;
  }

  .section-heading__code {
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--film-emulsion-dim);
    white-space: nowrap;
  }

  .section-heading__rule {
    flex: 1;
    max-width: 9rem;
    height: 1px;
    background: var(--film-rule);
  }

  .section-heading--center .section-heading__rule {
    max-width: 2.6rem;
  }
</style>
