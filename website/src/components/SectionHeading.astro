---
/**
 * Section heading: small orange eyebrow above an ink heading, with
 * a short orange rule beneath. Conventional on purpose.
 */
interface Props {
  eyebrow?: string;
  title: string;
  center?: boolean;
  level?: "h2" | "h3";
  intro?: string;
  id?: string;
}

const { eyebrow, title, center = false, level = "h2", intro, id } = Astro.props;
const Tag = level;
---

<div class:list={["section-heading", { "section-heading--center": center }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id}>{title}</Tag>
  <span class="section-heading__rule" aria-hidden="true"></span>
  {intro && <p class="section-heading__intro">{intro}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: 2.5rem;
    max-width: 46rem;
  }

  .section-heading--center {
    text-align: center;
    margin-inline: auto;
  }

  .section-heading .eyebrow {
    margin-bottom: var(--space-2);
  }

  .section-heading__rule {
    display: block;
    width: 2.5rem;
    height: 3px;
    border-radius: 2px;
    background: var(--ez-orange);
    margin-top: var(--space-3);
  }

  .section-heading--center .section-heading__rule {
    margin-inline: auto;
  }

  .section-heading__intro {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
