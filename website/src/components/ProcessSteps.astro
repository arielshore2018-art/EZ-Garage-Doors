---
/**
 * "What happens when you call" — numbered step cards.
 */
import SectionHeading from "./SectionHeading.astro";

interface Step {
  title: string;
  detail: string;
}

interface Props {
  steps?: Step[];
  heading?: string;
  eyebrow?: string;
  bare?: boolean;
}

const {
  heading = "What happens when you call",
  eyebrow = "The process",
  bare = false,
  steps = [
    { title: "Describe the issue", detail: "Tell us what the door is doing — stuck, loud bang, won't close, opener dead." },
    { title: "Send a photo if useful", detail: "A quick photo of the door, spring, or opener often speeds up the diagnosis." },
    { title: "Get your arrival window", detail: "We confirm the appointment and the time window before anyone drives out." },
    { title: "Written quote before work begins", detail: "You see the price in writing and approve it first. Then we do the repair." },
  ],
} = Astro.props;
---

<section class:list={["steps-sec", { "section section--alt": !bare }]} aria-labelledby="process-heading">
  <div class:list={{ wrap: !bare }}>
    <SectionHeading eyebrow={eyebrow} title={heading} />
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="steps__item">
            <span class="steps__num display-num" aria-hidden="true">{i + 1}</span>
            <h3 class="steps__title">{step.title}</h3>
            <p class="steps__detail">{step.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    counter-reset: step;
  }

  /* inside a content column (bare mode) four steps read as a 2×2 grid */
  .steps-sec:not(.section) .steps {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .steps__item {
    background: var(--ez-white);
    border: 1px solid var(--ez-line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
  }

  .steps__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--ez-orange);
    color: var(--ez-white);
    font-size: 1.35rem;
    margin-bottom: var(--space-3);
  }

  .steps__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .steps__detail {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
