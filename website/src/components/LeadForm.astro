---
import { BUSINESS, hasPhone } from "../config/business";
interface Props {
  heading?: string;
  submitLabel?: string;
  showPhotoField?: boolean;
  context?: string;
}
const { heading = "Tell us about your door", submitLabel = "Request Service", showPhotoField = true, context = "general" } = Astro.props;
const uid = context.replace(/[^a-z0-9]/gi, "-");
const ready = Boolean(BUSINESS.FORM_ENDPOINT);
---
<div class="lead-form" id="request">
  <p class="eyebrow">Your next step</p>
  <h3>{heading}</h3>
  <p class="lead-form__note">A few details now. A clear conversation next.</p>
  {!ready && <p class="lead-form__preview">Online requests are not available yet. This form is a preview and does not send your details.{hasPhone() && <> Please <a href={`tel:${BUSINESS.PRIMARY_PHONE_TEL}`}>call us for service</a>.</>}</p>}
  <form method="POST" action={BUSINESS.FORM_ENDPOINT || "#request"} enctype={showPhotoField ? "multipart/form-data" : undefined} data-lead-form data-form-context={context} data-form-ready={String(ready)}>
    <input type="hidden" name="form_context" value={context} />
    <input type="hidden" name="landing_page" data-landing-page />
    <input type="hidden" name="utm_source" data-utm="utm_source" />
    <input type="hidden" name="utm_medium" data-utm="utm_medium" />
    <input type="hidden" name="utm_campaign" data-utm="utm_campaign" />
    <input type="hidden" name="utm_term" data-utm="utm_term" />
    <input type="hidden" name="utm_content" data-utm="utm_content" />
    <p class="lead-form__hp" aria-hidden="true"><label for={`hp-${uid}`}>Company</label><input type="text" id={`hp-${uid}`} name="company" tabindex="-1" autocomplete="off" /></p>
    <div class="lead-form__row">
      <div class="field">
        <label for={`name-${uid}`}>Your name</label>
        <input type="text" id={`name-${uid}`} name="name" autocomplete="name" required aria-describedby={`name-error-${uid}`} />
        <span class="field-error" id={`name-error-${uid}`} data-error-for="name" aria-live="polite"></span>
      </div>
      <div class="field">
        <label for={`phone-${uid}`}>Phone number</label>
        <input type="tel" id={`phone-${uid}`} name="phone" autocomplete="tel" inputmode="tel" required aria-describedby={`phone-error-${uid}`} />
        <span class="field-error" id={`phone-error-${uid}`} data-error-for="phone" aria-live="polite"></span>
      </div>
    </div>
    <div class="field">
      <label for={`town-${uid}`}>Massachusetts town or ZIP</label>
      <input type="text" id={`town-${uid}`} name="town" autocomplete="address-level2" required aria-describedby={`town-error-${uid}`} />
      <span class="field-error" id={`town-error-${uid}`} data-error-for="town" aria-live="polite"></span>
    </div>
    <div class="field">
      <label for={`issue-${uid}`}>What can we help with?</label>
      <textarea id={`issue-${uid}`} name="issue" rows="3" required placeholder="For example, my door won’t close…" aria-describedby={`issue-error-${uid}`}></textarea>
      <span class="field-error" id={`issue-error-${uid}`} data-error-for="issue" aria-live="polite"></span>
    </div>
    <details class="lead-form__extras">
      <summary>Add {showPhotoField ? "a photo or " : ""}a preferred callback time <span>(optional)</span></summary>
      <div class="field"><label for={`callback-${uid}`}>Preferred callback time</label><input type="text" id={`callback-${uid}`} name="callback_time" placeholder="For example, after 4 pm…" /></div>
      {showPhotoField && <div class="field"><label for={`photo-${uid}`}>Photo of the door or opener</label><input type="file" id={`photo-${uid}`} name="photo" accept="image/*" /></div>}
    </details>
    <button type={ready ? "submit" : "button"} class="btn btn--call btn--lg lead-form__submit" data-track="form_submit_click">{ready ? submitLabel : "Preview request"} <span aria-hidden="true">→</span></button>
    <p class="lead-form__status" data-form-status role="status" tabindex="-1"></p>
    <p class="lead-form__consent">By submitting, you agree that {BUSINESS.name} may contact you about your request. Message/data rates may apply. Consent is not required to purchase. <a href="/privacy-policy/">Privacy Policy</a>.</p>
  </form>
</div>
<script>
  const messages: Record<string, string> = {
    name: "Please enter your name.",
    phone: "Enter a valid phone number, including the area code.",
    town: "Enter your Massachusetts town or ZIP.",
    issue: "Tell us a little about what you need.",
  };
  const invalid = (input: HTMLInputElement | HTMLTextAreaElement) => {
    const value = input.value.trim();
    if (!value) return true;
    if (input.name === "phone") {
      const digits = value.replace(/\D/g, "");
      return digits.length < 10 || digits.length > 15 || !/^[+\d\s().-]+$/.test(value);
    }
    return false;
  };
  document.querySelectorAll<HTMLFormElement>("form[data-lead-form]").forEach((form) => {
    form.noValidate = true;
    const button = form.querySelector<HTMLButtonElement>(".lead-form__submit")!;
    button.type = "submit";
    const originalLabel = button.innerHTML;
    const status = form.querySelector<HTMLElement>("[data-form-status]")!;
    const landing = form.elements.namedItem("landing_page") as HTMLInputElement;
    landing.value = location.pathname;
    form.addEventListener("submit", (event) => {
      const hp = form.elements.namedItem("company") as HTMLInputElement;
      if (hp.value || button.dataset.submitting === "1") { event.preventDefault(); return; }
      let firstBad: HTMLInputElement | HTMLTextAreaElement | null = null;
      for (const name of Object.keys(messages)) {
        const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
        const bad = invalid(field);
        field.setAttribute("aria-invalid", String(bad));
        form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!.textContent = bad ? messages[name] : "";
        if (bad && !firstBad) firstBad = field;
      }
      if (firstBad) { event.preventDefault(); firstBad.focus(); return; }
      if (form.dataset.formReady !== "true") {
        event.preventDefault();
        status.textContent = "Preview only — your request has not been sent. Online booking is not available yet.";
        status.focus();
        return;
      }
      button.dataset.submitting = "1";
      button.disabled = true;
      button.textContent = "Sending…";
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "form_submit", context: form.dataset.formContext, page: location.pathname });
    });
    form.addEventListener("input", (event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) return;
      if (field.getAttribute("aria-invalid") === "true" && !invalid(field)) {
        field.setAttribute("aria-invalid", "false");
        const error = form.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);
        if (error) error.textContent = "";
      }
    });
    window.addEventListener("pageshow", () => {
      delete button.dataset.submitting;
      button.disabled = false;
      button.innerHTML = originalLabel;
    });
  });
</script>
<style>
  .lead-form { background: white; color: var(--ez-charcoal); border: 1px solid var(--ez-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); padding: clamp(1.4rem, 3vw, 2.4rem); }
  .lead-form h3 { font-size: var(--text-2xl); margin-top: .5rem; }
  .lead-form__note { color: var(--ez-steel); margin: .5rem 0 1.5rem; }
  .lead-form__preview { background: var(--ez-alt); border: 1px solid var(--ez-line); font-size: var(--text-sm); padding: .75rem 1rem; margin-bottom: 1.3rem; border-radius: var(--radius-sm); }
  .lead-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .lead-form form > .field, .lead-form__row { margin-bottom: .8rem; }
  .field > label { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 650; }
  .field-error:empty { display: none; }
  .lead-form__extras { padding-block: .5rem 1rem; }
  .lead-form__extras summary { cursor: pointer; min-height: 44px; font-size: var(--text-sm); font-weight: 600; color: var(--ez-charcoal); }
  .lead-form__extras summary span { font-weight: 400; }
  .lead-form__extras .field { margin: .65rem 0; }
  .lead-form__hp { position: absolute; left: -9999px; height: 1px; overflow: hidden; margin: 0; }
  .lead-form__submit { width: 100%; justify-content: space-between; }
  .lead-form__submit:disabled { cursor: wait; opacity: .7; }
  .lead-form__status:not(:empty) { margin-top: 1rem; padding: .8rem; background: var(--ez-tint); font-size: var(--text-sm); }
  .lead-form__consent { font-size: var(--text-2xs); line-height: 1.5; color: var(--ez-steel); margin-top: 1rem; }
  @media(max-width: 36rem) { .lead-form__row { grid-template-columns: 1fr; gap: .8rem; } }
</style>
