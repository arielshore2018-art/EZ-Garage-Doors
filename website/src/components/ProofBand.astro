---
/**
 * Verified proof band: live platform ratings + counts.
 * Deliberately NO on-site quote cards — until verbatim reviews with
 * live links are supplied (launch blocker list), quotes stay off the
 * site. Platform chips become outbound links when profile URLs exist.
 */
import { Image } from "astro:assets";
import { reviews, REVIEWS_TOTAL_LINE } from "../config/reviews";
import googleLogo from "../assets/trust-logos/review-platforms/google-logo.webp";
import yelpLogo from "../assets/trust-logos/review-platforms/yelp-logo.webp";
import angiLogo from "../assets/trust-logos/review-platforms/angi-logo.webp";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  heading?: string;
  note?: string;
}

const {
  heading = "Rated by Massachusetts homeowners on the platforms we can't edit",
  note = "Counts change as new reviews come in — read them on the live platforms.",
} = Astro.props;

const platforms = [
  { key: "google", name: "Google", logo: googleLogo, data: reviews.google },
  { key: "yelp", name: "Yelp", logo: yelpLogo, data: reviews.yelp },
  { key: "angi", name: "Angi", logo: angiLogo, data: reviews.angi },
];
---

<section class="proof section" aria-labelledby="proof-heading">
  <div class="wrap">
    <SectionHeading eyebrow="Reviews" title={heading} center intro={REVIEWS_TOTAL_LINE} />

    <ul class="proof__platforms">
      {
        platforms.map((p) => (
          <li class="proof__chip">
            {p.data.url ? (
              <a href={p.data.url} rel="noopener" target="_blank" data-track={`review_platform_${p.key}`}>
                <Image src={p.logo} alt={`${p.name} reviews`} height={28} loading="lazy" />
                <span class="proof__stars" aria-hidden="true">★★★★★</span>
                <span class="proof__rating display-num">{p.data.rating}</span>
                <span class="proof__count">{p.data.count}+ reviews</span>
              </a>
            ) : (
              <span class="proof__static">
                <Image src={p.logo} alt={`${p.name} reviews`} height={28} loading="lazy" />
                <span class="proof__stars" aria-hidden="true">★★★★★</span>
                <span class="proof__rating display-num">{p.data.rating}</span>
                <span class="proof__count">{p.data.count}+ reviews</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>

    <p class="proof__note muted">{note} <a href="/reviews/">About our reviews →</a></p>
  </div>
</section>

<style>
  .proof {
    background: var(--ez-white);
  }

  .proof__platforms {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: 56rem;
    margin-inline: auto;
  }

  .proof__chip a,
  .proof__static {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    background: var(--ez-white);
    border: 1px solid var(--ez-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
    min-height: 64px;
  }

  .proof__chip a:hover {
    border-color: var(--ez-orange);
  }

  .proof__chip img {
    height: 28px;
    width: auto;
  }

  .proof__stars {
    color: var(--ez-orange);
    letter-spacing: 0.1em;
  }

  .proof__rating {
    font-size: var(--text-2xl);
    color: var(--ez-ink);
    line-height: 1;
  }

  .proof__count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .proof__note {
    font-size: var(--text-sm);
    margin-top: var(--space-5);
    text-align: center;
  }

  @media (max-width: 40rem) {
    .proof__platforms {
      grid-template-columns: 1fr;
    }
  }
</style>
