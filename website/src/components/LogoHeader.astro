---
/**
 * Full-site header (A1-style structure): utility strip with the policy
 * line, white bar with the color logo, dropdown nav (CSS hover +
 * focus-within, no JS), orange call CTA. Mobile menu is a no-JS
 * <details> disclosure grouped the same way as the dropdowns.
 */
import { Image } from "astro:assets";
import logo from "../assets/brand/ez-logo-primary-horizontal.svg";
import CallButton from "./CallButton.astro";
import { APPROVED_CLAIMS } from "../config/business";
import { MA_COUNTIES } from "../config/ma-towns";

interface NavItem {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}

const nav: NavItem[] = [
  {
    label: "Repair",
    href: "/garage-door-repair/",
    children: [
      { label: "Garage Door Repair", href: "/garage-door-repair/" },
      { label: "Broken Spring Repair", href: "/broken-spring-repair/" },
      { label: "Cable Repair", href: "/garage-door-cable-repair/" },
      { label: "Off-Track Door", href: "/garage-door-off-track-repair/" },
      { label: "Roller Replacement", href: "/garage-door-roller-replacement/" },
      { label: "Track Repair", href: "/garage-door-track-repair/" },
      { label: "Panel Replacement", href: "/garage-door-panel-replacement/" },
      { label: "Door Won't Close", href: "/garage-door-wont-close/" },
      { label: "Door Won't Open", href: "/garage-door-wont-open/" },
      { label: "Emergency Repair", href: "/emergency-garage-door-repair/" },
    ],
  },
  {
    label: "Openers",
    href: "/garage-door-openers/",
    children: [
      { label: "Opener Repair", href: "/garage-door-opener-repair/" },
      { label: "Opener Installation", href: "/garage-door-opener-installation/" },
      { label: "Remotes & Keypads", href: "/garage-door-remote-programming/" },
      { label: "Safety Sensors", href: "/garage-door-safety-sensor-repair/" },
      { label: "Smart Openers", href: "/smart-garage-door-opener/" },
      { label: "Brands We Service", href: "/brands/" },
    ],
  },
  {
    label: "New Doors",
    href: "/garage-door-installation/",
    children: [
      { label: "New Door Installation", href: "/garage-door-installation/" },
      { label: "Door Replacement", href: "/garage-door-replacement/" },
      { label: "Door Styles", href: "/garage-door-styles/" },
      { label: "What a New Door Costs", href: "/garage-door-replacement-cost/" },
      { label: "Finished Work", href: "/gallery/" },
    ],
  },
  {
    label: "Maintenance",
    href: "/garage-door-tune-up/",
    children: [
      { label: "Tune-Up & Inspection", href: "/garage-door-tune-up/" },
      { label: "Weatherstripping & Seals", href: "/garage-door-weatherstripping/" },
      { label: "Noisy Door Repair", href: "/noisy-garage-door-repair/" },
      { label: "Commercial Doors", href: "/commercial-garage-door-repair/" },
    ],
  },
  {
    label: "Service Areas",
    href: "/service-areas/",
    children: MA_COUNTIES.map((c) => ({ label: `${c.name} County`, href: `/service-areas/${c.slug}/` })),
  },
  {
    label: "Resources",
    href: "/guides/",
    children: [
      { label: "Guides & Troubleshooting", href: "/guides/" },
      { label: "Reviews", href: "/reviews/" },
      { label: "About EZ Garage Doors", href: "/about/" },
      { label: "Contact", href: "/contact/" },
    ],
  },
];

const current = Astro.url.pathname;
const isActive = (item: NavItem) =>
  current === item.href || (item.children?.some((c) => c.href === current) ?? false);
---

<div class="utility-strip">
  <div class="wrap utility-strip__inner">
    <p>Massachusetts, we’ve got your door.</p>
    <p class="utility-strip__right">{APPROVED_CLAIMS.writtenQuote}</p>
  </div>
</div>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label="EZ Garage Doors — home">
      <Image src={logo} alt="EZ Garage Doors — Fast. Reliable. Local." width={230} loading="eager" />
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul class="nav">
        {
          nav.map((item) => (
            <li class:list={["nav__item", { "nav__item--has-menu": !!item.children }]}>
              <a href={item.href} aria-current={isActive(item) ? "page" : undefined}>
                {item.label}
                {item.children && (
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12">
                    <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                )}
              </a>
              {item.children && (
                <ul class:list={["nav__menu", { "nav__menu--wide": item.children.length > 8 }]}>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={current === c.href ? "page" : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__cta">
      <CallButton label="Call for Repair" track="header_call" />
    </div>

    <details class="site-header__mobile">
      <summary aria-label="Open menu">
        <span class="site-header__burger" aria-hidden="true"></span>
        <span class="site-header__menu-word" aria-hidden="true">Menu</span>
        <span class="visually-hidden">Menu</span>
      </summary>
      <nav aria-label="Main mobile">
        <div class="site-header__mobile-cta">
          <CallButton label="Call Now" track="mobile_menu_call" />
          <a href="/services/" class="btn btn--outline" data-track="mobile_menu_services">Our Services</a>
        </div>
        {
          nav.map((item) => (
            <details class="site-header__group">
              <summary>{item.label}</summary>
              <ul>
                <li>
                  <a href={item.href}>All {item.label}</a>
                </li>
                {item.children?.map((c) => (
                  <li>
                    <a href={c.href}>{c.label}</a>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<style>
  .utility-strip {
    background: var(--ez-alt);
    color: var(--ez-charcoal);
    font-size: var(--text-xs);
  }

  .utility-strip__inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 0.4rem;
  }

  .utility-strip p {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .utility-strip__right {
    color: var(--ez-ink);
    font-weight: 600;
  }

  @media (max-width: 36rem) {
    .utility-strip__inner p:first-child {
      display: none;
    }
    .utility-strip__inner {
      justify-content: center;
    }
  }

  .site-header {
    background: var(--ez-white);
    border-bottom: 1px solid var(--ez-line);
    position: sticky;
    top: 0;
    z-index: 30;
    box-shadow: 0 2px 12px rgb(28 28 28 / 0.04);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 5.5rem;
  }

  .site-header__logo img {
    width: clamp(150px, 16vw, 230px);
    height: auto;
  }

  .site-header__nav {
    margin-left: auto;
  }

  .nav {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__item {
    position: relative;
  }

  .nav__item > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-weight: 650;
    font-size: .96rem;
    text-decoration: none;
    color: var(--ez-ink);
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    min-height: 44px;
  }

  .nav__item > a:hover,
  .nav__item:focus-within > a,
  .nav__item > a[aria-current="page"] {
    color: var(--ez-orange-text);
    background: var(--ez-tint);
  }

  .nav__menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 15.5rem;
    background: var(--ez-white);
    border: 1px solid var(--ez-line);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    box-shadow: var(--shadow-card-hover);
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    display: none;
    z-index: 40;
  }

  .nav__menu--wide {
    min-width: 30rem;
    columns: 2;
    column-gap: 0;
  }

  .nav__item:hover > .nav__menu,
  .nav__item:focus-within > .nav__menu {
    display: block;
  }

  .nav__item:nth-last-child(-n + 2) > .nav__menu {
    left: auto;
    right: 0;
  }

  .nav__menu li {
    break-inside: avoid;
  }

  .nav__menu a {
    display: block;
    padding: 0.5rem 1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ez-charcoal);
    text-decoration: none;
  }

  .nav__menu a:hover,
  .nav__menu a[aria-current="page"] {
    background: var(--ez-alt);
    color: var(--ez-orange-text);
  }

  .site-header__cta {
    display: flex;
    gap: var(--space-2);
  }

  .site-header__cta :global(.btn) {
    white-space: nowrap;
    padding-inline: 1.1rem;
  }

  .site-header__mobile {
    display: none;
    margin-left: auto;
  }

  .site-header__mobile > summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    cursor: pointer;
    list-style: none;
    border: 2px solid var(--ez-ink);
    border-radius: var(--radius-sm);
    min-width: 48px;
    height: 48px;
    padding: 0 0.8rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ez-ink);
  }

  .site-header__mobile > summary::-webkit-details-marker {
    display: none;
  }

  .site-header__mobile[open] > summary {
    background: var(--ez-ink);
    color: var(--ez-white);
  }

  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    position: relative;
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .site-header__burger::before {
    top: -5px;
  }

  .site-header__burger::after {
    top: 5px;
  }

  .site-header__mobile > nav {
    overscroll-behavior: contain;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--ez-white);
    border-bottom: 4px solid var(--ez-orange);
    box-shadow: var(--shadow-card-hover);
    max-height: calc(100dvh - 8rem);
    overflow-y: auto;
    padding-bottom: var(--space-4);
  }

  .site-header__mobile-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    padding: var(--space-4) clamp(1rem, 4vw, 2rem);
    border-bottom: 1px solid var(--ez-line);
  }

  .site-header__group {
    border-bottom: 1px solid var(--ez-line);
  }

  .site-header__group > summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    padding: 0.85rem clamp(1rem, 4vw, 2rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ez-ink);
    min-height: 48px;
  }

  .site-header__group > summary::-webkit-details-marker {
    display: none;
  }

  .site-header__group > summary::after {
    content: "+";
    color: var(--ez-orange);
    font-size: var(--text-xl);
  }

  .site-header__group[open] > summary::after {
    content: "–";
  }

  .site-header__group ul {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-2);
    background: var(--ez-alt);
  }

  .site-header__group a {
    display: block;
    padding: 0.65rem clamp(1.5rem, 6vw, 3rem);
    font-weight: 600;
    text-decoration: none;
    color: var(--ez-charcoal);
    min-height: 44px;
  }

  .site-header__group a:hover {
    color: var(--ez-orange-text);
  }

  @media (max-width: 66rem) {
    .site-header__nav,
    .site-header__cta {
      display: none;
    }

    .site-header__mobile {
      display: block;
    }
  }

  @media (max-width: 24rem) {
    .site-header__menu-word {
      display: none;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".site-header__mobile");
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
