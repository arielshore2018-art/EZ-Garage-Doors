---
/**
 * JSON-LD structured data. LocalBusiness on every page; optional
 * Service, FAQPage, and BreadcrumbList blocks per page.
 *
 * Deliberately absent until verified (do not add without live proof):
 * - telephone (no final number yet)
 * - aggregateRating / Review markup (counts unverified; third-party
 *   Google ratings must not be marked up as on-site reviews)
 * - license numbers, priceRange
 * - a street address (service-area business; base is not published)
 */
import { BUSINESS } from "../config/business";
import { MA_COUNTIES } from "../config/ma-towns";
import type { Crumb } from "./Breadcrumbs.astro";

interface Props {
  service?: {
    name: string;
    description: string;
    url: string;
  };
  faqs?: { question: string; answer: string }[];
  breadcrumbs?: Crumb[];
}

const { service, faqs, breadcrumbs } = Astro.props;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: BUSINESS.name,
  url: BUSINESS.SITE_URL,
  image: new URL("/og-default.png", BUSINESS.SITE_URL).href,
  slogan: BUSINESS.tagline,
  areaServed: [
    { "@type": "State", name: BUSINESS.state },
    ...MA_COUNTIES.map((c) => ({
      "@type": "AdministrativeArea",
      name: `${c.name} County, ${BUSINESS.stateAbbr}`,
    })),
  ],
  knowsAbout: [
    "garage door repair",
    "garage door spring replacement",
    "garage door opener repair",
    "garage door installation",
  ],
};

const serviceSchema = service
  ? {
      "@context": "https://schema.org",
      "@type": "Service",
      serviceType: service.name,
      description: service.description,
      url: new URL(service.url, BUSINESS.SITE_URL).href,
      provider: {
        "@type": "HomeAndConstructionBusiness",
        name: BUSINESS.name,
        url: BUSINESS.SITE_URL,
      },
      areaServed: { "@type": "State", name: BUSINESS.state },
    }
  : null;

const faqSchema =
  faqs && faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
      }
    : null;

/* Breadcrumbs: explicit trail when the page passes one; otherwise
   Home → Service derived from the service prop so every service page
   still gets a BreadcrumbList without per-page wiring. */
const trail: Crumb[] | null = breadcrumbs
  ? breadcrumbs
  : service
    ? [{ label: service.name, href: service.url }]
    : null;

const breadcrumbSchema = trail
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: BUSINESS.SITE_URL },
        ...trail.map((c, i) => ({
          "@type": "ListItem",
          position: i + 2,
          name: c.label,
          ...(c.href ? { item: new URL(c.href, BUSINESS.SITE_URL).href } : {}),
        })),
      ],
    }
  : null;
---

<script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
{serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
