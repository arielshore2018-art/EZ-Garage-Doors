---
/**
 * Visible breadcrumb trail for inner pages. The matching BreadcrumbList
 * JSON-LD is emitted by Schema.astro from the same `breadcrumbs` prop
 * passed to the layout — keep both in sync by passing one array.
 */
export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  class?: string;
  /** "dark" for trails on ink grounds (photo heroes). */
  tone?: "light" | "dark";
  /* forward the parent's scope attribute so its scoped CSS matches this root */
  [key: `data-astro-cid-${string}`]: unknown;
}

const { items, class: className = "", tone = "light", ...rest } = Astro.props;
---

<nav class:list={["crumbs", { "crumbs--dark": tone === "dark" }, className]} aria-label="Breadcrumb" {...rest}>
  <ol>
    <li><a href="/">Home</a></li>
    {
      items.map((c, i) => (
        <li>
          {c.href && i < items.length - 1 ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .crumbs li + li::before {
    content: "›";
    margin-right: 0.35rem;
    color: var(--ez-orange);
  }

  .crumbs a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ez-orange-text);
    text-decoration: underline;
  }

  .crumbs span {
    color: var(--ez-ink);
    font-weight: 600;
  }

  /* On ink grounds: muted links, white current page, orange-on-ink separators. */
  .crumbs--dark ol,
  .crumbs--dark a {
    color: var(--ez-on-ink-muted);
  }

  .crumbs--dark a:hover {
    color: var(--ez-white);
  }

  .crumbs--dark span {
    color: var(--ez-white);
  }

  .crumbs--dark li + li::before {
    color: var(--ez-orange-on-ink);
  }
</style>
