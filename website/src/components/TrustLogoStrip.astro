---
/**
 * Brand logo strip — "Brands we service" as a labeled logo band.
 * Reads the brand-logos manifest; never phrased as "authorized dealer",
 * "certified", or "partner". Non-affiliation line always renders.
 */
import { Image } from "astro:assets";
import { brandLogos } from "../config/brand-logos";

type Variant = "review-platforms" | "opener-brands" | "door-brands" | "combined";

interface Props {
  variant: Variant;
  slim?: boolean;
}

const { variant, slim = false } = Astro.props;

const pick = (cat: string) => brandLogos.filter((l) => l.enabled && l.category === cat);

const rows: { label: string; logos: typeof brandLogos }[] =
  variant === "review-platforms"
    ? [{ label: "Reviewed across", logos: pick("review-platform") }]
    : variant === "opener-brands"
      ? [{ label: "Opener brands we service", logos: pick("opener-brand") }]
      : variant === "door-brands"
        ? [{ label: "Door brands we service", logos: pick("door-brand") }]
        : [
            { label: "Opener brands we service", logos: pick("opener-brand") },
            { label: "Door brands we service", logos: pick("door-brand") },
          ];
---

<section class:list={["brands", { "brands--slim": slim }]} aria-label="Brands we service">
  <div class="wrap">
    {
      rows.map((row) => (
        <div class="brands__row">
          <p class="brands__label">{row.label}</p>
          <ul class="brands__logos">
            {row.logos.map((l) => (
              <li>
                <Image src={l.src} alt={l.alt} height={l.railHeight} loading="lazy" style={`height:${l.railHeight}px`} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    {
      variant !== "review-platforms" && (
        <p class="brands__note">
          We service these brands. We are not affiliated with or endorsed by any of them.
          <a href="/brands/">See all brands we service →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .brands {
    background: var(--ez-white);
    border-block: 1px solid var(--ez-line);
    padding-block: var(--space-6);
  }

  .brands--slim {
    padding-block: var(--space-4);
  }

  .brands__row + .brands__row {
    margin-top: var(--space-5);
  }

  .brands__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ez-orange-text);
    text-align: center;
    margin-bottom: var(--space-3);
  }

  .brands__logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .brands__logos img {
    width: auto;
    max-height: 40px;
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 140ms ease, opacity 140ms ease;
  }

  .brands__logos li:hover img {
    filter: none;
    opacity: 1;
  }

  .brands__note {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }
</style>
