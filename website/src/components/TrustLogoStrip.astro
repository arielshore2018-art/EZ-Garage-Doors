---
/**
 * Brand logo strip — "Brands we service" as a labeled logo band.
 * Reads the brand-logos manifest; never phrased as "authorized dealer",
 * "certified", or "partner". Non-affiliation line always renders.
 */
import { Image } from "astro:assets";
import { brandLogos } from "../config/brand-logos";

type Variant = "review-platforms" | "opener-brands" | "door-brands" | "combined";

interface Props {
  variant: Variant;
  slim?: boolean;
}

const { variant, slim = false } = Astro.props;
const moving = variant !== "review-platforms";

const pick = (cat: string) => brandLogos.filter((l) => l.enabled && l.category === cat);

const rows: { label: string; logos: typeof brandLogos }[] =
  variant === "review-platforms"
    ? [{ label: "Reviewed across", logos: pick("review-platform") }]
    : variant === "opener-brands"
      ? [{ label: "Opener brands we service", logos: pick("opener-brand") }]
      : variant === "door-brands"
        ? [{ label: "Door brands we service", logos: pick("door-brand") }]
        : [
            { label: "Opener brands we service", logos: pick("opener-brand") },
            { label: "Door brands we service", logos: pick("door-brand") },
          ];
---

<section class:list={["brands", { "brands--slim": slim }]} aria-label={moving ? "Brands we service" : "Review platforms"} data-brand-rail={moving || undefined}>
  <div class="wrap">
    {
      rows.map((row) => (
        <div class="brands__row">
          <p class="brands__label">{row.label}</p>
          <div class="brands__window">
            <div class="brands__track">
              {(moving ? [false, true] : [false]).map((duplicate) => (
                <ul class:list={["brands__logos", { "brands__duplicate": duplicate }]} aria-label={duplicate ? undefined : row.label} aria-hidden={duplicate || undefined}>
                  {row.logos.map((l) => (
                    <li>
                      <Image src={l.src} alt={duplicate ? "" : l.alt} height={l.railHeight} loading="eager" style={`height:${l.railHeight}px`} />
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        </div>
      ))
    }
    {moving && <div class="brands__controls"><button type="button" class="brands__pause" aria-pressed="false" hidden>Pause logo motion</button></div>}
    {
      variant !== "review-platforms" && (
        <p class="brands__note">
          We service these brands. We are not affiliated with or endorsed by any of them.
          {" "}<a href="/brands/">See all brands we service →</a>
        </p>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-brand-rail]").forEach((rail) => {
    const button = rail.querySelector<HTMLButtonElement>(".brands__pause")!;
    button.hidden = false;
    rail.dataset.motion = "ready";
    button.addEventListener("click", () => {
      const paused = rail.dataset.paused !== "true";
      rail.dataset.paused = String(paused);
      button.setAttribute("aria-pressed", String(paused));
      button.textContent = paused ? "Resume logo motion" : "Pause logo motion";
    });
  });
</script>

<style>
  .brands {
    background: var(--ez-white);
    border-block: 1px solid var(--ez-line);
    padding-block: var(--space-7);
    overflow: hidden;
  }

  .brands--slim {
    padding-block: var(--space-4);
  }

  .brands__row + .brands__row {
    margin-top: var(--space-6);
  }

  .brands__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ez-orange-text);
    text-align: center;
    margin-bottom: var(--space-3);
  }

  .brands__logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .brands__logos img {
    width: auto;
    max-height: 40px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brands__logos li { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; min-height: 60px; }
  .brands__duplicate { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    [data-motion="ready"] .brands__window {
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    }
    [data-motion="ready"] .brands__track { display: flex; width: 100%; }
    [data-motion="ready"] .brands__logos {
      display: flex;
      flex: 0 0 auto;
      flex-wrap: nowrap;
      justify-content: space-around;
      min-width: 100%;
      gap: 3rem;
      padding-right: 3rem;
      animation: brand-scroll 28s linear infinite;
    }
    [data-motion="ready"] .brands__row:nth-child(2) .brands__logos { animation-direction: reverse; animation-duration: 32s; }
    [data-paused="true"] .brands__logos,
    .brands__row:hover .brands__logos { animation-play-state: paused; }
  }

  @keyframes brand-scroll {
    to { transform: translateX(-100%); }
  }

  .brands__controls { display: flex; justify-content: center; margin-top: .65rem; }
  .brands__pause {
    min-height: 44px;
    padding: .4rem .9rem;
    background: transparent;
    border: 1px solid var(--ez-line);
    border-radius: var(--radius-pill);
    color: var(--ez-steel);
    font: inherit;
    font-size: .8125rem;
    cursor: pointer;
  }
  .brands__pause:hover { color: var(--ez-ink); border-color: var(--ez-ink); }
  @media (prefers-reduced-motion: reduce) {
    .brands__controls { display: none; }
  }

  .brands__note {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }
</style>
