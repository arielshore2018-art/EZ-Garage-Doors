---
/**
 * Micro-trust strip. Only owner-approved claims —
 * see APPROVED_CLAIMS in src/config/business.ts. "Licensed & Insured"
 * is intentionally absent until verified.
 */
import { APPROVED_CLAIMS } from "../config/business";
import Icon from "./Icon.astro";

interface Props {
  items?: string[];
  tone?: "light" | "dark";
}

const {
  items = [APPROVED_CLAIMS.years, APPROVED_CLAIMS.local, APPROVED_CLAIMS.writtenQuote],
  tone = "light",
} = Astro.props;
---

<ul class={`trust-bar trust-bar--${tone}`} aria-label="Why homeowners call EZ Garage Doors">
  {
    items.map((item) => (
      <li>
        <Icon name="check" size={18} />
        {item}
      </li>
    ))
  }
</ul>

<style>
  .trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .trust-bar li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .trust-bar svg {
    color: var(--ez-orange);
    flex-shrink: 0;
  }

  .trust-bar--light {
    color: var(--ez-ink);
  }

  .trust-bar--dark {
    color: var(--ez-white);
  }
</style>
